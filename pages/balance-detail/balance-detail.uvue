<template>
	<view class="page">
		<view class="hero">
			<view class="safe-nav" :style="{ paddingTop: statusBarHeight + 'px' }">
				<view class="nav-row">
					<view class="back-button" @click="goBack">
						<text class="back-glyph">‹</text>
					</view>
					<text class="nav-title">余额明细</text>
					<view class="nav-placeholder"></view>
				</view>
			</view>

			<view class="balance-row">
				<text class="balance-label">当前余额（元）</text>
				<text class="balance-value">¥ {{ balanceText }}</text>
			</view>

			<view class="summary-row">
				<view class="summary-pill">
					<text class="summary-text">本月充值 +¥{{ monthIncomeText }}</text>
				</view>
				<view class="summary-pill">
					<text class="summary-text">本月消费 -¥{{ monthExpenseText }}</text>
				</view>
			</view>
		</view>

		<scroll-view class="content-scroll" scroll-y>
			<view class="content-inner">
				<view class="filter-card">
					<view class="type-switch">
						<view class="type-tab" :class="{ 'type-tab-active': selectedType === 'all' }" @click="selectType('all')">
							<text class="type-text" :class="{ 'type-text-active': selectedType === 'all' }">全部</text>
						</view>
						<view class="type-tab" :class="{ 'type-tab-active': selectedType === 'income' }" @click="selectType('income')">
							<text class="type-text" :class="{ 'type-text-active': selectedType === 'income' }">充值</text>
						</view>
						<view class="type-tab" :class="{ 'type-tab-active': selectedType === 'expense' }" @click="selectType('expense')">
							<text class="type-text" :class="{ 'type-text-active': selectedType === 'expense' }">消费</text>
						</view>
					</view>

					<view class="date-row">
						<view class="date-pill" :class="{ 'date-pill-active': selectedRange === 'today' }" @click="selectRange('today')">
							<text class="date-text" :class="{ 'date-text-active': selectedRange === 'today' }">今天</text>
						</view>
						<view class="date-pill" :class="{ 'date-pill-active': selectedRange === 'week' }" @click="selectRange('week')">
							<text class="date-text" :class="{ 'date-text-active': selectedRange === 'week' }">本周</text>
						</view>
						<view class="date-pill" :class="{ 'date-pill-active': selectedRange === 'month' }" @click="selectRange('month')">
							<text class="date-text" :class="{ 'date-text-active': selectedRange === 'month' }">本月</text>
						</view>
						<picker class="date-picker" mode="date" :value="customDate" :start="startDate" :end="todayDate" @change="onCustomDateChange">
							<view class="date-pill date-pill-custom" :class="{ 'date-pill-active': selectedRange === 'custom' }">
								<view class="calendar-icon">
									<view class="calendar-body"></view>
									<view class="calendar-line"></view>
								</view>
								<text class="date-text" :class="{ 'date-text-active': selectedRange === 'custom' }">{{ customDateLabel() }}</text>
							</view>
						</picker>
					</view>
				</view>

				<view v-if="loading" class="empty-card">
					<text class="empty-text">加载中...</text>
				</view>
				<view v-else-if="groups.length === 0" class="empty-card">
					<text class="empty-text">暂无收支记录</text>
				</view>

				<view v-for="group in groups" :key="group.key" class="list-card">
					<view class="group-head">
						<text class="group-title">{{ group.title }}</text>
						<text class="group-summary">{{ group.summaryText }}</text>
					</view>
					<view v-for="(order, index) in group.orders" :key="order.id" class="order-row">
						<view class="order-icon" :class="order.isIncome ? 'order-icon-income' : 'order-icon-expense'">
							<text class="order-icon-text" :class="order.isIncome ? 'order-icon-text-income' : 'order-icon-text-expense'">{{ order.isIncome ? '+' : '-' }}</text>
						</view>
						<view class="order-info">
							<text class="order-title">{{ order.title }}</text>
							<text class="order-subtitle">{{ order.subtitle }}</text>
						</view>
						<text class="order-amount" :class="{ 'order-amount-income': order.isIncome }">{{ order.amountText }}</text>
						<view v-if="index < group.orders.length - 1" class="order-divider"></view>
					</view>
				</view>

				<text class="list-note">仅展示近30天的收支记录</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import dayjs from 'dayjs'
	import { BalanceGroup, BalanceOrder, buildBalanceGroups } from '../../common/balance'
	import { fetchCurrentUserInfo } from '../../common/auth'
	import { formatMoney } from '../../common/money'
	import { get } from '../../common/request'

	const statusBarHeight = ref(24)
	const balanceText = ref('0.00')
	const monthIncomeText = ref('0.00')
	const monthExpenseText = ref('0.00')
	const selectedType = ref('all')
	const selectedRange = ref('month')
	const customDate = ref(dayjs().format('YYYY-MM-DD'))
	const todayDate = ref(dayjs().format('YYYY-MM-DD'))
	const startDate = ref(dayjs().subtract(29, 'day').format('YYYY-MM-DD'))
	const orders = ref<BalanceOrder[]>([])
	const groups = ref<BalanceGroup[]>([])
	const loading = ref(true)

	onLoad(() => {
		const sys = uni.getSystemInfoSync()
		statusBarHeight.value = sys.statusBarHeight
	})

	onShow(() => {
		loadBalance()
		loadOrders()
	})

	function loadBalance (): void {
		fetchCurrentUserInfo((userInfo) => {
			balanceText.value = formatMoney(userInfo.getString('balance') ?? '0', 2)
		}, () => {})
	}

	function loadOrders (): void {
		loading.value = true
		get('/top_up_order?order_type=payment_time&order=desc', (res) => {
			const code = res.getNumber('code', 0)
			if (code !== 200) {
				loading.value = false
				return
			}
			const items = res.getArray<UTSJSONObject>('data')
			const parsed: BalanceOrder[] = []
			const minTime = dayjs().subtract(29, 'day').startOf('day').valueOf()
			if (items != null) {
				for (let i = 0; i < items.length; i++) {
					const item = new BalanceOrder()
					item.initFromJSON(items[i])
					if (item.dateKey.length === 0 || dayjs(item.dateKey).valueOf() >= minTime) {
						parsed.push(item)
					}
				}
			}
			orders.value = parsed
			updateMonthlySummary()
			rebuildGroups()
			loading.value = false
		}, () => {
			loading.value = false
		})
	}

	function updateMonthlySummary (): void {
		let income = 0
		let expense = 0
		const now = dayjs()
		for (let i = 0; i < orders.value.length; i++) {
			const order = orders.value[i]
			if (!dayjs(order.dateKey).isSame(now, 'month')) {
				continue
			}
			if (order.amount >= 0) {
				income += order.amount
			} else {
				expense += Math.abs(order.amount)
			}
		}
		monthIncomeText.value = formatMoney(income.toString(), 2)
		monthExpenseText.value = formatMoney(expense.toString(), 2)
	}

	function rebuildGroups (): void {
		groups.value = buildBalanceGroups(orders.value, selectedType.value, selectedRange.value, customDate.value)
	}

	function selectType (type: string): void {
		selectedType.value = type
		rebuildGroups()
	}

	function selectRange (range: string): void {
		selectedRange.value = range
		rebuildGroups()
	}

	function onCustomDateChange (event: UniEvent): void {
		customDate.value = event.detail.value as string
		selectedRange.value = 'custom'
		rebuildGroups()
	}

	function customDateLabel (): string {
		return dayjs(customDate.value).format('M月D日')
	}

	function goBack (): void {
		uni.navigateBack()
	}
</script>

<style lang="scss">
