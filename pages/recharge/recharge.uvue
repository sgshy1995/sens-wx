	}

	.agreement-check-mark {
		font-size: 11px;
		line-height: 11px;
		color: #FFFFFF;
	}

	.agreement-text {
		font-size: 11px;
		line-height: 18px;
		color: #9CA3AF;
	}

	.agreement-link {
		font-size: 11px;
		line-height: 18px;
		color: #FF6B35;
	}

	.footer {
		padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
		background: #FFFFFF;
		box-shadow: 0 -4px 16px rgba(23, 26, 36, 0.06);
	}

	.pay-button {
		width: 100%;
		height: 48px;
		margin: 0;
		padding: 0;
		display: flex;
