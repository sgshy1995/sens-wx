		margin-top: 2px;
		flex-shrink: 0;
	}

	.hero-tip-text {
		flex: 1;
		font-size: 11px;
		line-height: 17px;
		color: rgba(255, 255, 255, 0.82);
	}

	.content-scroll {
		flex: 1;
		height: 0;
	}

	.content-inner {
		padding: 18px 16px 24px;
	}

	.section-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.section-title {
		font-size: 16px;
		font-weight: 700;
		line-height: 22px;
		color: #1A1D24;
	}

	.section-note {
		font-size: 11px;
		line-height: 16px;
		color: #9CA3AF;
	}

	.amount-grid {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 12px;
	}

	.amount-option {
		position: relative;
		width: calc((100% - 24px) / 4);
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		background: #FFFFFF;
		border: none !important;
		border-radius: 9px;
		outline: none !important;
		box-shadow: none !important;
		-webkit-appearance: none;
		appearance: none;
		-webkit-tap-highlight-color: transparent;
	}

	.amount-option-active {
		background: #FFF8F4;
		border: none !important;
		box-shadow: none !important;
	}

	.amount-option-ring {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		box-sizing: border-box;
		border: 1px solid #EEF0F3;
		border-radius: 9px;
		pointer-events: none;
	}

	.amount-option-ring-active {
		border: 1px solid #FF6B35;
	}

	.amount-option-text {
		font-size: 14px;
		font-weight: 500;
		color: #1A1D24;
	}

	.amount-option-text-active {
		color: #FF6B35;
	}

	.custom-input-wrap {
		position: relative;
		height: 48px;
		margin-top: 10px;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 14px;
		padding-right: 14px;
		box-sizing: border-box;
		background: #FFFFFF;
