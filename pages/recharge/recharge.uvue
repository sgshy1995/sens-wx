<template>
	<view class="page">
		<view class="hero">
			<view class="safe-nav" :style="{ paddingTop: statusBarHeight + 'px' }">
				<view class="nav-row">
					<view class="back-button" @click="goBack">
						<text class="back-glyph">‹</text>
					</view>
					<text class="nav-title">余额充值管理</text>
					<view class="nav-placeholder"></view>
				</view>
			</view>

			<view class="balance-row">
				<view class="balance-copy">
					<text class="balance-label">当前余额（元）</text>
					<text class="balance-value">¥ {{ balanceText }}</text>
				</view>
				<view class="detail-pill" @click="showBalanceDetailTip">
					<text class="detail-pill-text">明细</text>
				</view>
			</view>

			<view class="hero-tip-row">
				<image class="tips-icon" src="/static/icons/ic-tips.svg" mode="aspectFit"></image>
				<text class="hero-tip-text">账户余额只可在本软件中用于线上消费相关，不支持提现或变现；如有疑问，请联系客服。</text>
			</view>
		</view>

		<scroll-view class="content-scroll" scroll-y>
			<view class="content-inner">
				<view class="section-head">
					<text class="section-title">选择充值金额</text>
					<text class="section-note">充值后实时到账</text>
				</view>

				<view class="amount-grid">
					<view
						v-for="amount in amountOptions"
						:key="amount"
						class="amount-option"
						:class="{ 'amount-option-active': !customSelected && selectedAmount === amount }"
						@click="selectAmount(amount)"
					>
						<view class="amount-option-ring" :class="{ 'amount-option-ring-active': !customSelected && selectedAmount === amount }"></view>
						<text
							class="amount-option-text"
							:class="{ 'amount-option-text-active': !customSelected && selectedAmount === amount }"
						>¥{{ formatOptionAmount(amount) }}</text>
					</view>
					<view
						class="amount-option"
						:class="{ 'amount-option-active': customSelected }"
						@click="selectCustomAmount"
					>
						<view class="amount-option-ring" :class="{ 'amount-option-ring-active': customSelected }"></view>
						<text
							class="amount-option-text"
							:class="{ 'amount-option-text-active': customSelected }"
						>自定义</text>
					</view>
				</view>

				<view v-if="customSelected" class="custom-input-wrap">
					<view class="custom-input-border"></view>
					<text class="custom-currency">¥</text>
					<input
						class="custom-input"
						type="number"
						maxlength="6"
						style="border: 0; outline: 0; box-shadow: none; appearance: none; -webkit-appearance: none;"
						:value="formatCustomInput()"
						@input="onCustomAmountInput"
					/>
				</view>

				<text class="payment-title">支付方式</text>

				<view class="payment-card">
					<image class="wx-icon" src="/static/icons/ic-wx.svg" mode="aspectFit"></image>
					<text class="payment-name">微信支付</text>
					<view class="payment-check">
						<text class="payment-check-mark">✓</text>
					</view>
				</view>

				<view class="agreement-row" @click="toggleAgreement">
					<view class="agreement-check" :class="{ 'agreement-check-active': agreementAccepted }">
						<text v-if="agreementAccepted" class="agreement-check-mark">✓</text>
					</view>
					<text class="agreement-text">已阅读并同意</text>
					<text class="agreement-link">《用户服务协议》</text>
					<text class="agreement-text">与</text>
					<text class="agreement-link">《充值服务协议》</text>
				</view>
			</view>
		</scroll-view>

		<view class="footer">
			<button
				class="pay-button"
				:class="{ 'pay-button-disabled': !canSubmitPayment() }"
				:disabled="!canSubmitPayment()"
				hover-class="none"
				@click="handlePay"
			>
				<text
					class="pay-button-text"
					:class="{ 'pay-button-text-disabled': !canSubmitPayment() }"
				>{{ payButtonText() }}</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { fetchCurrentUserInfo } from '../../common/auth'
	import { formatMoney } from '../../common/money'
	import { get, post } from '../../common/request'

	const statusBarHeight = ref(24)
	const balanceText = ref('0.00')
	const amountOptions = ref<number[]>([100, 300, 500, 1000, 3000, 5000, 10000])
	const selectedAmount = ref(300)
	const customSelected = ref(false)
	const customAmount = ref('0')
	const agreementAccepted = ref(true)
	const paying = ref(false)
	let paymentPollTimer = -1
	let paymentPollCount = 0
	let activeOutTradeNo = ''

	onLoad(() => {
		const sys = uni.getSystemInfoSync()
		statusBarHeight.value = sys.statusBarHeight
	})

	onShow(() => {
		loadBalance()
	})

	onUnload(() => {
		stopPaymentPolling()
	})

	function loadBalance (): void {
		fetchCurrentUserInfo((userInfo) => {
			balanceText.value = formatMoney(userInfo.getString('balance') ?? '0', 2)
		}, () => {})
	}

	function selectAmount (amount: number): void {
		selectedAmount.value = amount
		customSelected.value = false
	}

	function selectCustomAmount (): void {
		customSelected.value = true
	}

	function onCustomAmountInput (event: UniEvent): void {
		const raw = event.detail.value as string
		customAmount.value = normalizeCustomAmount(raw)
	}

	function normalizeCustomAmount (value: string): string {
		let source = value
		const dotIndex = source.indexOf('.')
		if (dotIndex >= 0) {
			source = source.substring(0, dotIndex)
		}
		let digits = ''
		for (let i = 0; i < source.length; i++) {
			const char = source.charAt(i)
			if (char >= '0' && char <= '9') {
				digits += char
			}
		}
		if (digits.length === 0) {
			return ''
		}
		const amount = Number(digits)
		if (amount > 99999) {
			return '99999'
		}
		if (amount <= 0) {
			return '0'
		}
		return amount.toString()
	}

	function customAmountValid (): boolean {
		if (!customSelected.value || customAmount.value.length === 0) {
			return false
		}
		const amount = Number(customAmount.value)
		return amount > 0 && amount <= 99999 && amount === Math.floor(amount)
	}

	function canSubmitPayment (): boolean {
		return customSelected.value ? customAmountValid() : selectedAmount.value > 0
	}

	function currentPayAmount (): number {
		return customSelected.value ? Number(customAmount.value) : selectedAmount.value
	}

	function formatOptionAmount (amount: number): string {
		return formatMoney(amount.toString(), 0)
	}

	function formatCustomInput (): string {
		if (customAmount.value.length === 0) {
			return ''
		}
		return formatMoney(customAmount.value, 0)
	}

	function payButtonText (): string {
		if (!canSubmitPayment()) {
			return '确认支付'
		}
		return '确认支付 ¥' + formatMoney(currentPayAmount().toString(), 0)
	}

	function toggleAgreement (): void {
		if (!paying.value) {
			agreementAccepted.value = !agreementAccepted.value
		}
	}

	function showBalanceDetailTip (): void {
		uni.navigateTo({
			url: '/pages/balance-detail/balance-detail'
		})
	}

	function goBack (): void {
		if (paying.value) {
			return
		}
		uni.navigateBack()
	}

	function handlePay (): void {
		if (paying.value || !canSubmitPayment()) {
			return
		}
		if (!agreementAccepted.value) {
			uni.showToast({
				title: '请先阅读并同意充值协议',
				icon: 'none'
			})
			return
		}

		paying.value = true
		uni.showLoading({ title: '请稍后', mask: true })
		uni.login({
			provider: 'weixin',
			success: (loginRes) => {
				const loginCode = loginRes.code
				if (loginCode.length === 0) {
					finishPayment()
					uni.showToast({ title: '获取微信登录凭证失败', icon: 'none' })
					return
				}
				submitRechargePayment(loginCode)
			},
			fail: () => {
				finishPayment()
				uni.showToast({ title: '获取微信登录凭证失败', icon: 'none' })
			}
		})
	}

	function submitRechargePayment (loginCode: string): void {
		const amount = currentPayAmount()
		const body = new UTSJSONObject()
		body.set('amount', amount.toString())
		body.set('login_code', loginCode)
		post('/payments/balance-recharge/orders', body, (res) => {
			if (res.getNumber('code', 0) !== 200) {
				finishPayment()
				uni.showToast({
					title: res.getString('message') ?? '充值失败，请稍后重试',
					icon: 'none'
				})
				return
			}
			const data = res.getJSON('data')
			if (data == null) {
				finishPayment()
				uni.showToast({ title: '充值订单数据为空', icon: 'none' })
				return
			}
			if (data.getString('status') === 'PAID') {
				finishPayment()
				showRechargeSuccess(data, amount)
				return
			}
			const outTradeNo = data.getString('out_trade_no') ?? ''
			const payment = data.getJSON('payment')
			if (outTradeNo.length === 0 || payment == null) {
				finishPayment()
				uni.showToast({ title: '微信支付参数不完整', icon: 'none' })
				return
			}
			requestWechatPayment(outTradeNo, payment, amount)
		}, (message) => {
			finishPayment()
			uni.showToast({ title: message, icon: 'none' })
		})
	}

	function requestWechatPayment (outTradeNo: string, payment: UTSJSONObject, amount: number): void {
		uni.hideLoading()
		// #ifdef MP-WEIXIN
		uni.requestPayment({
			provider: 'wxpay',
			orderInfo: '',
			timeStamp: payment.getString('time_stamp') ?? '',
			nonceStr: payment.getString('nonce_str') ?? '',
			package: payment.getString('package') ?? '',
			signType: 'RSA',
			paySign: payment.getString('pay_sign') ?? '',
			success: () => {
				startPaymentPolling(outTradeNo, amount)
			},
			fail: (error) => {
				finishPayment()
				const message = error.errMsg ?? ''
				uni.showToast({
					title: message.indexOf('cancel') >= 0 ? '已取消支付' : '微信支付未完成',
					icon: 'none'
				})
			}
		})
		// #endif
		// #ifndef MP-WEIXIN
		finishPayment()
		uni.showToast({ title: '当前平台不支持微信小程序支付', icon: 'none' })
		// #endif
	}

	function startPaymentPolling (outTradeNo: string, amount: number): void {
		stopPaymentPolling()
		activeOutTradeNo = outTradeNo
		paymentPollCount = 0
		uni.showLoading({ title: '请稍后', mask: true })
		schedulePaymentPoll(amount)
	}

	function schedulePaymentPoll (amount: number): void {
		paymentPollTimer = setTimeout(() => {
			pollPaymentStatus(amount)
		}, 1200)
	}

	function pollPaymentStatus (amount: number): void {
		paymentPollTimer = -1
		if (activeOutTradeNo.length === 0) {
			return
		}
		if (paymentPollCount >= 60) {
			finishPayment()
			uni.showToast({ title: '充值结果确认中，请稍后查看余额', icon: 'none' })
			return
		}
		paymentPollCount++
		const outTradeNo = activeOutTradeNo
		get('/payments/orders/' + encodeURIComponent(outTradeNo) + '/status', (res) => {
			if (activeOutTradeNo !== outTradeNo) {
				return
			}
			if (res.getNumber('code', 0) !== 200) {
				schedulePaymentPoll(amount)
				return
			}
			const data = res.getJSON('data')
			if (data == null) {
				schedulePaymentPoll(amount)
				return
			}
			const status = data.getString('status') ?? 'PENDING'
			if (status === 'PAID') {
				finishPayment()
				showRechargeSuccess(data, amount)
				return
			}
			if (status === 'CLOSED' || status === 'REFUNDED') {
				finishPayment()
				uni.showToast({ title: status === 'CLOSED' ? '充值订单已关闭' : '充值订单已退款', icon: 'none' })
				return
			}
			schedulePaymentPoll(amount)
		}, () => {
			if (activeOutTradeNo === outTradeNo) {
				schedulePaymentPoll(amount)
			}
		})
	}

	function showRechargeSuccess (data: UTSJSONObject, fallbackAmount: number): void {
		const amount = data.getString('amount') ?? fallbackAmount.toString()
		const paymentTime = data.getString('payment_time') ?? ''
		const orderNo = data.getString('order_no') ?? (data.getString('out_trade_no') ?? '')
		uni.redirectTo({
			url: '/pages/recharge-success/recharge-success?amount=' + encodeURIComponent(amount)
				+ '&time=' + encodeURIComponent(paymentTime)
				+ '&orderNo=' + encodeURIComponent(orderNo)
		})
	}

	function stopPaymentPolling (): void {
		if (paymentPollTimer >= 0) {
			clearTimeout(paymentPollTimer)
			paymentPollTimer = -1
		}
		activeOutTradeNo = ''
		paymentPollCount = 0
	}

	function finishPayment (): void {
		stopPaymentPolling()
		paying.value = false
		uni.hideLoading()
	}
</script>

<style lang="scss">
