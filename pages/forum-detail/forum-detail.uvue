<template>
	<view class="page">
		<view class="nav-space" :style="{ height: statusBarHeight + 'px' }"></view>
		<view class="nav-row">
			<view class="back-button" @click="goBack">
				<text class="back-glyph">‹</text>
			</view>
			<text class="nav-title">帖子详情</text>
			<view class="more-button">
				<view class="more-dot"></view>
				<view class="more-dot"></view>
				<view class="more-dot"></view>
			</view>
		</view>

		<view v-if="loadingArticle" class="loading-wrap">
			<text class="loading-text">加载中...</text>
		</view>

		<view v-else-if="!hasArticle" class="empty-state">
			<image class="empty-icon" src="/static/icons/ic-empty.svg" mode="aspectFit"></image>
			<text class="empty-text">帖子不存在或已删除</text>
		</view>

		<template v-else>
			<view class="article-block">
				<image v-if="article.cover.length > 0" class="article-cover" :src="resolveFileUrl(article.cover)" mode="aspectFill"></image>

				<view class="article-main">
					<text class="article-title">{{ article.title }}</text>

					<view class="author-row">
						<image v-if="article.avatar.length > 0" class="author-avatar" :src="resolveFileUrl(article.avatar)" mode="aspectFill"></image>
						<view v-else class="author-avatar author-avatar-empty">
							<text>{{ article.name.length > 0 ? article.name.substring(0, 1) : '康' }}</text>
						</view>
						<view class="author-copy">
							<text class="author-name">{{ article.name.length > 0 ? article.name : '康复用户' }}</text>
							<text class="author-time">{{ article.timeText }}</text>
						</view>
						<view class="follow-button">
							<text class="follow-text">+ 关注</text>
						</view>
					</view>

					<rich-text v-if="article.content.length > 0" class="article-content" :nodes="article.content"></rich-text>

					<view v-if="article.tagName.length > 0" class="tag-row">
						<view class="tag-chip">
							<text class="tag-text">{{ lastTagName(article.tagName) }}</text>
						</view>
					</view>
				</view>
			</view>

			<view class="divider"></view>

			<view id="comments-section" class="comments-section">
				<text class="comments-title">全部评论 · {{ article.commentNum }}</text>

				<view v-if="commentsReady && comments.length === 0" class="comments-empty">
					<image class="comments-empty-icon" src="/static/icons/ic-empty.svg" mode="aspectFit"></image>
					<text class="comments-empty-text">暂无评论</text>
				</view>

				<view v-else class="comment-list">
					<view v-for="(item, index) in comments" :key="item.id + '-' + index" class="comment-item">
						<image v-if="item.avatar.length > 0" class="comment-avatar" :src="resolveFileUrl(item.avatar)" mode="aspectFill"></image>
						<view v-else class="comment-avatar comment-avatar-empty">
							<text>{{ item.name.length > 0 ? item.name.substring(0, 1) : '评' }}</text>
						</view>
						<view class="comment-content-wrap">
							<text class="comment-name">{{ item.name.length > 0 ? item.name : '康复用户' }}</text>
							<text class="comment-content">
								<text v-if="item.toName.length > 0" class="comment-reply">回复 @{{ item.toName }}：</text>{{ item.content }}
							</text>
							<text class="comment-meta">{{ item.floor }} 楼 · {{ item.timeText }}</text>
						</view>
					</view>
				</view>

				<view v-if="loadingComments" class="comment-status"><text>加载中...</text></view>
				<view v-else-if="finishedComments && comments.length > 0" class="comment-status"><text>已经到底了</text></view>
			</view>
		</template>

		<view class="action-bar">
			<view class="action-inner">
				<view class="comment-input" @click="openCommentComposer">
					<text class="comment-placeholder">说点什么…</text>
				</view>
				<view class="action-item" @click="openCommentComposer">
					<image class="action-icon" src="/static/icons/ic-comment.svg" mode="aspectFit"></image>
					<text class="action-count">{{ article.commentNum }}</text>
				</view>
				<view class="action-item" @click="toggleArticleFavorite">
					<image class="action-icon" :src="article.isCollected ? '/static/icons/ic-star-active.svg' : '/static/icons/ic-star.svg'" mode="aspectFit"></image>
					<text class="action-count">{{ article.collectNum }}</text>
				</view>
				<view class="action-item" @click="toggleArticleLike">
					<image class="action-icon" :src="article.isLiked ? '/static/icons/ic-like-active.svg' : '/static/icons/ic-like.svg'" mode="aspectFit"></image>
					<text class="action-count">{{ article.likeNum }}</text>
				</view>
			</view>
		</view>

		<view v-if="commentVisible" class="comment-mask" @click="closeCommentComposer">
			<view class="comment-panel" @click.stop>
				<view class="comment-panel-header">
					<text class="comment-panel-title">写评论</text>
					<view class="comment-panel-close" @click="closeCommentComposer">
						<text class="comment-panel-close-text">关闭</text>
					</view>
				</view>
				<textarea
					class="comment-textarea"
					:value="commentDraft"
					:disabled="submittingComment"
					maxlength="500"
					placeholder="说说你的看法…"
					placeholder-class="comment-textarea-placeholder"
					@input="onCommentInput"
				></textarea>
				<view class="comment-panel-footer">
					<text class="comment-length">{{ commentDraft.length }}/500</text>
					<view
						class="comment-submit"
						:class="{ 'comment-submit-disabled': submittingComment || commentDraft.trim().length === 0 }"
						@click="submitComment"
					>
						<text class="comment-submit-text">{{ submittingComment ? '提交中' : '确定' }}</text>
					</view>
				</view>
			</view>
		</view>

		<view v-if="noticeVisible" class="notice-layer">
			<view class="notice-card">
				<view class="notice-accent"></view>
				<text class="notice-text">{{ noticeText }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { hasLocalToken } from '../../common/auth'
	import { get, post } from '../../common/request'
	import { ForumArticleDetail, ForumCommentItem, lastTagName, resolveFileUrl } from '../../common/forum'

	const statusBarHeight = ref(24)
	const articleId = ref('')
	const article = ref(new ForumArticleDetail())
	const comments = ref<ForumCommentItem[]>([])
	const hasArticle = ref(false)
	const loadingArticle = ref(true)
	const loadingComments = ref(false)
	const commentsReady = ref(false)
	const finishedComments = ref(false)
	const page = ref(1)
	const pageSize = ref(10)
	const likePending = ref(false)
	const favoritePending = ref(false)
	const noticeVisible = ref(false)
	const noticeText = ref('')
	const focusComments = ref(false)
	const commentVisible = ref(false)
	const commentDraft = ref('')
	const submittingComment = ref(false)
	const INTERACTION_DEBOUNCE_MS = 700
	let lastLikeTapAt = 0
	let lastFavoriteTapAt = 0
	let noticeTimer = -1
	let pageShown = false
	let loadedLoggedIn = false

	function goBack (): void {
		uni.navigateBack()
	}

	function requireLogin (content: string): boolean {
		if (hasLocalToken()) {
			return true
		}
		uni.showModal({
			title: '请先登录',
			content: content,
			showCancel: false,
			success: () => {
				uni.navigateTo({ url: '/pages/login-guide/login-guide' })
			}
		})
		return false
	}

	function showNotice (message: string): void {
		if (message.length === 0) {
			return
		}
		noticeText.value = message
		noticeVisible.value = true
		if (noticeTimer >= 0) {
			clearTimeout(noticeTimer)
		}
		noticeTimer = setTimeout(() => {
			noticeVisible.value = false
			noticeTimer = -1
		}, 2400)
	}

	function showRequestError (res: UTSJSONObject, fallback: string): void {
		showNotice(res.getString('message') ?? fallback)
	}

	function toggleArticleLike (): void {
		const now = Date.now()
		if (likePending.value || now - lastLikeTapAt < INTERACTION_DEBOUNCE_MS) {
			showNotice('操作太频繁，请稍后再试')
			return
		}
		if (!requireLogin('登录后才能点赞文章')) {
			return
		}
		lastLikeTapAt = now
		const nextStatus = article.value.isLiked ? 0 : 1
		const requestData = new UTSJSONObject()
		requestData.set('target_type', 1)
		requestData.set('target_id', article.value.id)
		requestData.set('status', nextStatus)
		likePending.value = true
		post('/forum_like', requestData, (res) => {
			likePending.value = false
			if (res.getNumber('code', 0) !== 200) {
				showRequestError(res, '操作失败')
				return
			}
			article.value.isLiked = nextStatus === 1
			if (article.value.isLiked) {
				article.value.likeNum += 1
			} else {
				article.value.likeNum = Math.max(0, article.value.likeNum - 1)
			}
			showNotice(article.value.isLiked ? '点赞成功' : '已取消点赞')
		}, (message) => {
			likePending.value = false
			showNotice(message)
		})
	}

	function toggleArticleFavorite (): void {
		const now = Date.now()
		if (favoritePending.value || now - lastFavoriteTapAt < INTERACTION_DEBOUNCE_MS) {
			showNotice('操作太频繁，请稍后再试')
			return
		}
		if (!requireLogin('登录后才能收藏文章')) {
			return
		}
		lastFavoriteTapAt = now
		const nextStatus = article.value.isCollected ? 0 : 1
		const requestData = new UTSJSONObject()
		requestData.set('article_id', article.value.id)
		requestData.set('status', nextStatus)
		favoritePending.value = true
		post('/forum_favorite', requestData, (res) => {
			favoritePending.value = false
			if (res.getNumber('code', 0) !== 200) {
				showRequestError(res, '操作失败')
				return
			}
			article.value.isCollected = nextStatus === 1
			if (article.value.isCollected) {
				article.value.collectNum += 1
			} else {
				article.value.collectNum = Math.max(0, article.value.collectNum - 1)
			}
			showNotice(article.value.isCollected ? '收藏成功' : '已取消收藏')
		}, (message) => {
			favoritePending.value = false
			showNotice(message)
		})
	}

	function openCommentComposer (): void {
		if (!requireLogin('登录后才能评论文章')) {
			return
		}
		commentDraft.value = ''
		commentVisible.value = true
	}

	function closeCommentComposer (): void {
		if (submittingComment.value) {
			return
		}
		commentVisible.value = false
		commentDraft.value = ''
	}

	function onCommentInput (event: UniEvent): void {
		commentDraft.value = event.detail.value as string
	}

	function submitComment (): void {
		if (submittingComment.value || commentDraft.value.trim().length === 0) {
			return
		}
		const requestData = new UTSJSONObject()
		requestData.set('article_id', article.value.id)
		requestData.set('content', commentDraft.value.trim())
		submittingComment.value = true
		post('/forum_comment', requestData, (res) => {
			submittingComment.value = false
			if (res.getNumber('code', 0) !== 200) {
				showRequestError(res, '评论失败')
				return
			}
			commentVisible.value = false
			commentDraft.value = ''
			showNotice('评论成功，等待审核通过即可显示')
		}, (message) => {
			submittingComment.value = false
			showNotice(message)
		})
	}

	function appendComments (items: Array<UTSJSONObject>, pageNo: number, reset: boolean): void {
		const parsed: ForumCommentItem[] = []
		for (let i = 0; i < items.length; i++) {
			const item = new ForumCommentItem()
			const floor = (pageNo - 1) * pageSize.value + i + 1
			item.initFromJSON(items[i], floor)
			parsed.push(item)
		}
		if (reset) {
			comments.value = parsed
		} else {
			for (let i = 0; i < parsed.length; i++) {
				comments.value.push(parsed[i])
			}
		}
	}

	function finishCommentLoading (): void {
		loadingComments.value = false
		commentsReady.value = true
	}

	function loadComments (reset: boolean): void {
		if (loadingComments.value || articleId.value.length === 0 || !hasArticle.value) {
			return
		}
		if (!reset && finishedComments.value) {
			return
		}
		if (reset) {
			page.value = 1
			finishedComments.value = false
			commentsReady.value = false
		}
		loadingComments.value = true
		const pageNo = page.value
		const url = '/forum_comment/public/article/' + articleId.value + '?pageNo=' + pageNo + '&pageSize=' + pageSize.value
		get(url, (res) => {
			const body = res.getJSON('data')
			if (body == null) {
				finishCommentLoading()
				return
			}
			const items = body.getArray<UTSJSONObject>('data')
			if (items != null) {
				appendComments(items, pageNo, reset)
			}
			const totalCount = body.getNumber('totalCount', 0)
			article.value.commentNum = totalCount
			if (comments.value.length >= totalCount || (items != null && items.length < pageSize.value)) {
				finishedComments.value = true
			} else {
				page.value += 1
			}
			finishCommentLoading()
		}, (message) => {
			finishCommentLoading()
			showNotice(message)
		})
	}

	function loadArticle (): void {
		if (articleId.value.length === 0) {
			loadingArticle.value = false
			return
		}
		const detailPath = hasLocalToken() ? '/forum_article/id/' : '/forum_article/public/id/'
		get(detailPath + articleId.value, (res) => {
			const body = res.getJSON('data')
			if (body == null) {
				loadingArticle.value = false
				return
			}
			const detail = new ForumArticleDetail()
			detail.initFromJSON(body)
			article.value = detail
			hasArticle.value = true
			loadingArticle.value = false
			loadComments(true)
			if (focusComments.value) {
				focusComments.value = false
				setTimeout(() => {
					uni.pageScrollTo({
						selector: '#comments-section',
						duration: 350
					})
				}, 200)
			}
		}, (message) => {
			loadingArticle.value = false
			showNotice(message)
		})
	}

	onLoad((options) => {
		const sys = uni.getSystemInfoSync()
		const status = sys.statusBarHeight
		statusBarHeight.value = status
		const id = options['id']
		if (id != null) {
			articleId.value = id
		}
		const focusComment = options['focusComment']
		if (focusComment != null && focusComment === '1') {
			focusComments.value = true
		}
		loadedLoggedIn = hasLocalToken()
		loadArticle()
	})

	onShow(() => {
		if (!pageShown) {
			pageShown = true
			return
		}
		const loggedIn = hasLocalToken()
		if (articleId.value.length > 0 && loggedIn !== loadedLoggedIn) {
			loadedLoggedIn = loggedIn
			loadArticle()
		}
	})

	onReachBottom(() => {
		loadComments(false)
	})

	onUnload(() => {
		if (noticeTimer >= 0) {
			clearTimeout(noticeTimer)
			noticeTimer = -1
		}
	})
</script>

<style lang="scss">
	.page {
		min-height: 100vh;
		background: #FFFFFF;
	}

	.nav-space {
		background: #FFFFFF;
	}

	.nav-row {
		height: 48px;
		padding-left: 16px;
		padding-right: 16px;
		display: flex;
		flex-direction: row;
		align-items: center;
		background: #FFFFFF;
	}

	.back-button {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: #F7F8FA;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.back-glyph {
		font-size: 28px;
		line-height: 28px;
		color: #1A1D24;
		margin-top: -3px;
	}

	.nav-title {
		flex: 1;
		margin-left: 12px;
		font-size: 16px;
		font-weight: 600;
		color: #1A1D24;
	}

	.more-button {
		width: 20px;
		height: 4px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.more-dot {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: #6B7280;
	}

	.loading-wrap {
		padding: 80px 20px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.loading-text {
		font-size: 13px;
		color: #9CA3AF;
	}

	.empty-state {
		padding: 80px 20px 120px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.empty-icon {
		width: 180px;
		height: 180px;
	}

	.empty-text {
		margin-top: 12px;
		font-size: 13px;
		color: #9CA3AF;
	}

	.article-block {
		padding: 8px 20px 4px;
		display: flex;
		flex-direction: column;
	}

	.article-main {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.article-title {
		font-size: 20px;
		font-weight: 700;
		line-height: 28px;
		color: #1A1D24;
		word-break: break-all;
	}

	.author-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 10px;
	}

	.author-avatar {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: #EEF0F4;
		flex-shrink: 0;
	}

	.author-avatar-empty {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 14px;
		color: #6B7280;
	}

	.author-copy {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.author-name {
		font-size: 13px;
		font-weight: 600;
		color: #1A1D24;
	}

	.author-time {
		font-size: 11px;
		color: #9CA3AF;
	}

	.follow-button {
		padding: 5px 12px;
		border-radius: 999px;
		background: #FFF3EC;
		flex-shrink: 0;
	}

	.follow-text {
		font-size: 12px;
		font-weight: 600;
		color: #FF6B35;
	}

	.article-cover {
		width: 100%;
		height: 170px;
		border-radius: 14px;
		margin-bottom: 24px;
		background: #F1F2F5;
	}

	.article-content {
		width: 100%;
		font-size: 14px;
		line-height: 23px;
		color: #1A1C24;
		word-break: break-all;
