		gap: 16px;
	}

	.comments-title {
		font-size: 15px;
		font-weight: 600;
		color: #1A1D24;
	}

	.comments-empty {
		padding: 48px 0 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.comments-empty-icon {
		width: 140px;
		height: 140px;
	}

	.comments-empty-text {
		margin-top: 8px;
		font-size: 12px;
		color: #9CA3AF;
	}

	.comment-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.comment-item {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 10px;
	}

	.comment-avatar {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: #EEF0F4;
		flex-shrink: 0;
	}

	.comment-avatar-empty {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		color: #6B7280;
	}

	.comment-content-wrap {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.comment-name {
		font-size: 12px;
		font-weight: 600;
		color: #6B7280;
	}

	.comment-content {
		font-size: 13px;
		line-height: 20px;
		color: #1A1D24;
		word-break: break-all;
	}

	.comment-reply {
		color: #FF6B35;
	}

	.comment-meta {
		font-size: 10px;
		color: #9CA3AF;
	}

	.comment-status {
		padding: 8px 0 4px;
		text-align: center;
		font-size: 12px;
		color: #9CA3AF;
	}

	.action-bar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		background: #FFFFFF;
		border-top: 1px solid #EEF0F3;
		padding-bottom: env(safe-area-inset-bottom);
		z-index: 20;
	}

	.action-inner {
		height: 60px;
		padding-left: 16px;
		padding-right: 16px;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 14px;
	}

	.comment-input {
		flex: 1;
		height: 36px;
		padding-left: 12px;
		padding-right: 12px;
		border-radius: 999px;
		background: #F7F8FA;
		display: flex;
		align-items: center;
