<template>
	<view class="page">
		<view class="nav-shell" :style="{ paddingTop: statusBarHeight + 'px' }">
			<view class="nav-row">
				<view class="back-button" @click="goBack"><text class="back-glyph">‹</text></view>
				<text class="nav-title">支付确认</text>
				<view class="nav-placeholder"></view>
			</view>
		</view>

		<scroll-view class="content-scroll" scroll-y>
			<view class="content">
				<view class="summary-card">
					<view class="summary-main">
						<view class="summary-icon-wrap">
							<image class="summary-icon" src="/static/icons/ic-mine-scheme.svg" mode="aspectFit"></image>
						</view>
						<view class="summary-copy">
							<view class="summary-tags">
								<view v-for="(label, index) in firstFourLabels()" :key="label + index" class="summary-tag">
									<text class="summary-tag-text">{{ label }}</text>
								</view>
								<view v-if="hasMoreLabels()" class="summary-tag summary-tag-more">
									<text class="summary-tag-more-text">等描述</text>
								</view>
							</view>
							<text class="product-title">专属康复方案 购买</text>
							<text class="product-description">{{ resourceSummary }}</text>
						</view>
					</view>
					<view class="summary-divider"></view>
					<view class="price-line">
						<text class="price-label">方案价格</text>
						<view class="price-copy">
							<text class="price-current">¥{{ priceText() }}</text>
							<text v-if="showOriginalPrice()" class="price-original">¥{{ originalPriceText() }}</text>
						</view>
					</view>
				</view>

				<view class="payment-card">
					<view class="card-head">
						<view class="card-title-wrap">
							<view class="card-title-icon"><image class="card-title-image" src="/static/icons/ic-order.svg" mode="aspectFit"></image></view>
							<text class="card-title">选择支付方式</text>
						</view>
					</view>
					<view class="payment-row" :class="{ 'payment-row-active': paymentType === 0 }" @click="selectPayment(0)">
					<image class="payment-icon" src="/static/icons/ic-balance-pay.svg" mode="aspectFit"></image>
					<view class="payment-copy">
						<view class="payment-name-row">
							<text class="payment-name">余额支付</text>
							<view class="recommend-badge"><text class="recommend-text">推荐</text></view>
						</view>
						<text class="payment-desc">可用余额 ¥{{ balanceText() }}</text>
					</view>
					<view class="radio" :class="{ 'radio-active': paymentType === 0 }">
						<view v-if="paymentType === 0" class="radio-dot"></view>
					</view>
				</view>
				<view class="divider"></view>
				<view class="payment-row" :class="{ 'payment-row-active': paymentType === 1 }" @click="selectPayment(1)">
					<image class="payment-icon" src="/static/icons/ic-wechat-pay.svg" mode="aspectFit"></image>
					<view class="payment-copy">
						<text class="payment-name">微信支付</text>
						<text class="payment-desc">使用微信快捷支付</text>
					</view>
					<view class="radio" :class="{ 'radio-active': paymentType === 1 }">
						<view v-if="paymentType === 1" class="radio-dot"></view>
					</view>
				</view>
				</view>

			</view>
		</scroll-view>

		<view class="footer">
			<view class="total-group">
				<text class="total-label">应付金额</text>
				<view class="total-price-row"><text class="total-symbol">¥</text><text class="total-amount">{{ priceText() }}</text></view>
			</view>
			<button class="pay-button" :disabled="paying || loading" hover-class="none" @click="handlePay">
				<image v-if="!paying && !loading" class="pay-icon" src="/static/icons/ic-success.svg" mode="aspectFit"></image>
				<text class="pay-button-text">{{ paying ? '请稍后...' : '立即支付' }}</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { formatMoney } from '../../common/money'
	import { PrescriptionPlanPreview } from '../../common/prescription-filter'
	import { get, post } from '../../common/request'
	import { fetchCurrentUserInfo } from '../../common/auth.uts'

	const statusBarHeight = ref(24)
	const prescriptionTagId = ref('')
	const dictionaryItemIds = ref('')
	const expectedSignature = ref('')
	const sourceType = ref('manual')
	const agreementVersion = ref('v1')
	const tagName = ref('康复方案')
	const resourceSummary = ref('')
	const selectedLabels = ref<string[]>([])
	const price = ref('0')
	const originalPrice = ref('0')
	const balance = ref('0')
	const paymentType = ref(0)
	const loading = ref(true)
	const paying = ref(false)
	let paymentPollTimer = -1
	let paymentPollCount = 0
	let activeOutTradeNo = ''

	onLoad((options) => {
		const sys = uni.getSystemInfoSync()
		statusBarHeight.value = sys.statusBarHeight
		prescriptionTagId.value = decodeOption(options['prescriptionTagId'] ?? '')
		dictionaryItemIds.value = decodeOption(options['dictionaryItemIds'] ?? '')
		expectedSignature.value = decodeOption(options['expectedSignature'] ?? '')
		sourceType.value = decodeOption(options['sourceType'] ?? 'manual')
		agreementVersion.value = decodeOption(options['agreementVersion'] ?? 'v1')
		loadPreview()
		loadBalance()
	})

	onUnload(() => stopPaymentPolling())

	function decodeOption (value: string): string {
		try { return decodeURIComponent(value) } catch (error) { return value }
	}

	function buildSelectionBody (): UTSJSONObject {
		const body = new UTSJSONObject()
		body.set('prescription_tag_id', prescriptionTagId.value)
		const ids = dictionaryItemIds.value.length > 0 ? dictionaryItemIds.value.split(',') : []
		const selectedItems: UTSJSONObject[] = []
		for (let i = 0; i < ids.length; i++) {
			const item = new UTSJSONObject()
			item.set('dictionary_item_id', ids[i])
			selectedItems.push(item)
		}
		body.set('dictionary_items', selectedItems)
		return body
	}

	function loadPreview (): void {
		post('/rehab_plan/preview', buildSelectionBody(), (res) => {
			loading.value = false
			if (res.getNumber('code', 0) !== 200) {
				uni.showToast({ title: res.getString('message') ?? '方案加载失败', icon: 'none' })
				return
			}
			const data = res.getJSON('data')
			if (data == null) return
			const preview = new PrescriptionPlanPreview()
			preview.initFromJSON(data)
			tagName.value = preview.tagName
			expectedSignature.value = preview.planSignature
			price.value = preview.price
			originalPrice.value = preview.originalPrice
			resourceSummary.value = preview.videoCount.toString() + ' 视频 · ' + preview.imageCount.toString() + ' 图片 · ' + preview.textCount.toString() + ' 文字'
			const labels: string[] = [preview.tagName]
			for (let i = 0; i < preview.conditions.length; i++) {
				const itemName = preview.conditions[i].itemName
				if (itemName.length > 0 && !labels.includes(itemName)) {
					labels.push(itemName)
				}
			}
			selectedLabels.value = labels
		}, (message) => {
			loading.value = false
			uni.showToast({ title: message, icon: 'none' })
		})
	}

	function loadBalance (): void {
		fetchCurrentUserInfo((userInfo) => {
			balance.value = userInfo.getString('balance') ?? '0'
		}, () => {})
	}

	function selectPayment (type: number): void {
		if (!paying.value) paymentType.value = type
	}

	function firstFourLabels (): string[] {
		const result: string[] = []
		for (let i = 0; i < selectedLabels.value.length && i < 4; i++) {
			result.push(selectedLabels.value[i])
		}
		return result
	}

	function hasMoreLabels (): boolean {
		return selectedLabels.value.length > 4
	}

	function priceText (): string { return formatMoney(price.value, 2) }
	function originalPriceText (): string { return formatMoney(originalPrice.value, 2) }
	function balanceText (): string { return formatMoney(balance.value, 2) }
	function showOriginalPrice (): boolean { return Number(originalPrice.value) > Number(price.value) }

	function paymentBody (): UTSJSONObject {
		const body = buildSelectionBody()
		body.set('expected_plan_signature', expectedSignature.value)
		body.set('agreement_accepted', true)
		body.set('agreement_version', agreementVersion.value)
		body.set('source_type', sourceType.value)
		return body
	}

	function handlePay (): void {
		if (paying.value || loading.value) return
		if (paymentType.value === 0 && Number(balance.value) < Number(price.value)) {
			uni.showToast({ title: '余额不足，请先充值或选择微信支付', icon: 'none' })
			return
		}
		if (paymentType.value === 1) {
			createWechatPayment()
			return
		}
		payWithBalance()
	}

	function payWithBalance (): void {
		paying.value = true
		uni.showLoading({ title: '请稍后', mask: true })
		post('/rehab_plan/orders/balance', paymentBody(), (res) => {
			finishPay()
			if (res.getNumber('code', 0) !== 200) {
				uni.showToast({ title: res.getString('message') ?? '支付失败', icon: 'none' })
				return
			}
			const data = res.getJSON('data')
			if (data != null) showPlanSuccess(data, '余额支付')
		}, (message) => {
			finishPay()
			uni.showToast({ title: message, icon: 'none' })
		})
	}

	function createWechatPayment (): void {
		paying.value = true
		uni.showLoading({ title: '请稍后', mask: true })
		uni.login({
			provider: 'weixin',
			success: (loginRes) => {
				if (loginRes.code.length === 0) {
					finishPay()
					uni.showToast({ title: '获取微信登录凭证失败', icon: 'none' })
					return
				}
				const body = paymentBody()
				body.set('login_code', loginRes.code)
				post('/payments/rehab-plan/orders', body, (res) => {
					if (res.getNumber('code', 0) !== 200) {
						finishPay()
						uni.showToast({ title: res.getString('message') ?? '微信支付下单失败', icon: 'none' })
						return
					}
					const data = res.getJSON('data')
					if (data == null) {
						finishPay()
						return
					}
					if (data.getString('status') === 'PAID') {
						finishPay()
						showPlanSuccess(data, '微信支付')
						return
					}
					const outTradeNo = data.getString('out_trade_no') ?? ''
					const payment = data.getJSON('payment')
					if (outTradeNo.length === 0 || payment == null) {
						finishPay()
						uni.showToast({ title: '微信支付参数不完整', icon: 'none' })
						return
					}
					requestWechatPayment(outTradeNo, payment)
				}, (message) => {
					finishPay()
					uni.showToast({ title: message, icon: 'none' })
				})
			},
			fail: () => {
				finishPay()
				uni.showToast({ title: '获取微信登录凭证失败', icon: 'none' })
			}
		})
	}

	function requestWechatPayment (outTradeNo: string, payment: UTSJSONObject): void {
		uni.hideLoading()
		// #ifdef MP-WEIXIN
		uni.requestPayment({
			provider: 'wxpay',
			orderInfo: '',
			timeStamp: payment.getString('time_stamp') ?? '',
			nonceStr: payment.getString('nonce_str') ?? '',
			package: payment.getString('package') ?? '',
			signType: 'RSA',
			paySign: payment.getString('pay_sign') ?? '',
			success: () => startPaymentPolling(outTradeNo),
			fail: (error) => {
				finishPay()
				const message = error.errMsg ?? ''
				uni.showToast({ title: message.indexOf('cancel') >= 0 ? '已取消支付' : '微信支付未完成', icon: 'none' })
			}
		})
		// #endif
		// #ifndef MP-WEIXIN
		finishPay()
		uni.showToast({ title: '当前平台不支持微信支付', icon: 'none' })
		// #endif
	}

	function startPaymentPolling (outTradeNo: string): void {
		stopPaymentPolling()
		activeOutTradeNo = outTradeNo
		paymentPollCount = 0
		uni.showLoading({ title: '请稍后', mask: true })
		schedulePaymentPoll()
	}

	function schedulePaymentPoll (): void {
		paymentPollTimer = setTimeout(pollPaymentStatus, 1200)
	}

	function pollPaymentStatus (): void {
		paymentPollTimer = -1
		if (activeOutTradeNo.length === 0) return
		if (paymentPollCount >= 60) {
			finishPay()
			uni.showToast({ title: '支付结果确认中，请稍后查看订单', icon: 'none' })
			return
		}
		paymentPollCount++
		get('/payments/orders/' + encodeURIComponent(activeOutTradeNo) + '/status', (res) => {
			if (res.getNumber('code', 0) !== 200) {
				schedulePaymentPoll()
				return
			}
			const data = res.getJSON('data')
			if (data == null) {
				schedulePaymentPoll()
				return
			}
			const status = data.getString('status') ?? 'PENDING'
			if (status === 'PAID') {
				finishPay()
				showPlanSuccess(data, '微信支付')
				return
			}
			if (status === 'CLOSED' || status === 'REFUNDED') {
				finishPay()
				uni.showToast({ title: '支付订单已关闭', icon: 'none' })
				return
			}
			schedulePaymentPoll()
		}, () => schedulePaymentPoll())
	}

	function showPlanSuccess (data: UTSJSONObject, paymentText: string): void {
		const planOrderId = data.getString('plan_order_id') ?? data.getString('id') ?? ''
		const resultTitle = '专属康复方案'
		const amount = data.getString('amount') ?? price.value
		const paymentTime = data.getString('payment_time') ?? data.getString('paid_at') ?? ''
		const orderNo = data.getString('order_no') ?? data.getString('out_trade_no') ?? ''
		uni.redirectTo({
			url: '/pages/rehab-unlock-success/rehab-unlock-success?planOrderId=' + encodeURIComponent(planOrderId)
				+ '&title=' + encodeURIComponent(resultTitle)
				+ '&amount=' + encodeURIComponent(amount)
				+ '&time=' + encodeURIComponent(paymentTime)
				+ '&orderNo=' + encodeURIComponent(orderNo)
				+ '&paymentTypeText=' + encodeURIComponent(paymentText)
		})
	}

	function stopPaymentPolling (): void {
		if (paymentPollTimer >= 0) {
			clearTimeout(paymentPollTimer)
			paymentPollTimer = -1
		}
		activeOutTradeNo = ''
		paymentPollCount = 0
	}

	function finishPay (): void {
		stopPaymentPolling()
		paying.value = false
		uni.hideLoading()
	}

	function goBack (): void {
		if (!paying.value) uni.navigateBack()
	}
</script>

<style lang="scss">
	.page {
		display: flex;
		height: 100vh;
		flex-direction: column;
		overflow: hidden;
		background: #F4F6F8;
	}

	.nav-shell {
		flex: 0 0 auto;
		background: #FFFFFF;
		border-bottom: 1px solid #F1F2F4;
	}

	.nav-row {
		display: flex;
		height: 50px;
		flex-direction: row;
		align-items: center;
		padding: 0 16px;
		box-sizing: border-box;
	}

	.back-button {
		display: flex;
		width: 32px;
		height: 32px;
		align-items: center;
		justify-content: center;
		border-radius: 16px;
		background: #F5F6F8;
	}

	.back-glyph {
		margin-top: -3px;
		font-size: 28px;
		line-height: 30px;
		color: #1A1D24;
	}

	.nav-title {
		flex: 1;
		text-align: center;
		font-size: 17px;
		font-weight: 600;
		color: #1A1D24;
	}

	.nav-placeholder {
		width: 32px;
		height: 32px;
	}

	.content-scroll {
		min-height: 0;
		flex: 1;
		height: 0;
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 16px 16px 28px;
		box-sizing: border-box;
	}

	.summary-card {
		display: flex;
		flex-direction: column;
		padding: 17px;
		border: 1px solid #FFE1D4;
		border-radius: 16px;
		background-image: linear-gradient(135deg, #FFFDFC 0%, #FFF4EE 100%);
		box-shadow: 0 8px 22px rgba(240, 90, 42, 0.07);
		box-sizing: border-box;
	}

	.summary-main {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 12px;
	}

	.summary-icon-wrap {
		display: flex;
		width: 46px;
		height: 46px;
		flex: 0 0 46px;
		align-items: center;
		justify-content: center;
		border-radius: 14px;
		background: #FFFFFF;
		box-shadow: 0 4px 12px rgba(240, 90, 42, 0.08);
	}

	.summary-icon {
		width: 34px;
		height: 34px;
	}

	.summary-copy {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
	}

	.summary-tags {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 5px;
	}

	.summary-tag {
		padding: 3px 8px;
		border-radius: 10px;
		background: #FFE9DE;
	}

	.summary-tag-text {
		font-size: 10px;
		font-weight: 500;
		color: #E85225;
	}

	.summary-tag-more {
		background: #F2F3F5;
	}

	.summary-tag-more-text {
		font-size: 10px;
		color: #7C838C;
	}

	.product-title {
		margin-top: 7px;
		font-size: 17px;
		font-weight: 700;
		line-height: 24px;
		color: #241E1B;
	}

	.product-description {
		margin-top: 4px;
		font-size: 11px;
		line-height: 17px;
		color: #8B7469;
	}

	.summary-divider {
		width: 100%;
		height: 1px;
		margin: 14px 0 12px;
		background: #F4E3DB;
	}

	.price-line {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.price-label {
		font-size: 11px;
		color: #9A8378;
	}

	.price-copy {
		display: flex;
		flex-direction: row;
		align-items: baseline;
		gap: 7px;
	}

	.price-current {
		font-size: 23px;
		font-weight: 700;
		line-height: 28px;
