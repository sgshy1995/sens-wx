		border-radius: 8px;
		background: #FFF1E9;
	}

	.card-title-image {
		width: 15px;
		height: 15px;
	}

	.card-title {
		font-size: 14px;
		font-weight: 700;
		color: #1A1D24;
	}

	.payment-row {
		display: flex;
		min-height: 62px;
		flex-direction: row;
		align-items: center;
		gap: 12px;
		margin: 0 -8px;
		padding: 9px 10px;
		border: 1px solid transparent;
		border-radius: 12px;
		box-sizing: border-box;
	}

	.payment-row-active {
		border-color: #FFD8C8;
		background: #FFF9F6;
	}

	.payment-icon {
		width: 34px;
		height: 34px;
		flex: 0 0 34px;
	}

	.payment-copy {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		gap: 3px;
	}

	.payment-name-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 7px;
	}

	.payment-name {
		font-size: 14px;
		font-weight: 500;
		color: #1A1D24;
	}

	.payment-desc {
		font-size: 10px;
		line-height: 15px;
		color: #9CA3AF;
	}

	.recommend-badge {
		padding: 2px 6px;
		border-radius: 8px;
		background: #EAF8EF;
	}

	.recommend-text {
		font-size: 9px;
		font-weight: 500;
		color: #17A34A;
	}

	.radio {
		display: flex;
		width: 20px;
		height: 20px;
		flex: 0 0 20px;
		align-items: center;
		justify-content: center;
		border: 1px solid #CDD2D9;
		border-radius: 10px;
		box-sizing: border-box;
	}

	.radio-active {
		border-color: #FF6B35;
	}

	.radio-dot {
		width: 9px;
		height: 9px;
		border-radius: 5px;
		background: #FF6B35;
	}

	.divider {
		width: 100%;
		height: 1px;
		margin: 2px 0;
		background: #F2F3F5;
	}

	.footer {
		display: flex;
		flex: 0 0 auto;
		flex-direction: row;
		align-items: center;
		gap: 14px;
		padding: 11px 16px calc(11px + env(safe-area-inset-bottom));
		background: #FFFFFF;
		box-shadow: 0 -6px 20px rgba(23, 26, 36, 0.07);
	}

	.total-group {
		display: flex;
		width: 102px;
		flex: 0 0 102px;
		flex-direction: column;
		gap: 1px;
	}

	.total-label {
		font-size: 10px;
		line-height: 15px;
		color: #9CA3AF;
	}

	.total-price-row {
		display: flex;
		flex-direction: row;
		align-items: baseline;
		gap: 2px;
	}

	.total-symbol {
		font-size: 12px;
		font-weight: 600;
		color: #F05A2A;
	}

	.total-amount {
		font-size: 22px;
