<template>
	<view class="page">
		<view class="nav-space" :style="{ height: statusBarHeight + 'px' }"></view>

		<view class="assistant-header">
			<view class="assistant-copy">
				<text class="assistant-title">AI 康复助手</text>
				<text class="assistant-subtitle">智能评估 · 一键生成专属方案</text>
			</view>
		</view>

		<view v-if="topics.length > 0" class="topic-toolbar">
			<view class="topic-toolbar-main" @click="openTopicDrawer">
				<image class="topic-toolbar-icon" src="/static/icons/ic-comment.svg" mode="aspectFit"></image>
				<view class="topic-toolbar-copy">
					<text class="topic-toolbar-label">当前话题</text>
					<text class="topic-toolbar-title">{{ currentTopicTitle }}</text>
				</view>
				<text class="topic-toolbar-action">历史话题</text>
			</view>
			<view class="topic-toolbar-new" @click="createNewTopic(false)">
				<text class="topic-toolbar-new-text">+ 新建</text>
			</view>
		</view>

		<scroll-view
			class="chat-scroll"
			scroll-y
			:scroll-top="scrollTop"
			:scroll-into-view="scrollIntoView"
			:upper-threshold="48"
			@scrolltoupper="loadOlderMessages"
		>
			<view class="message-list">
				<view v-if="initialLoading" class="list-status"><text>正在加载对话...</text></view>
				<view v-else-if="loadingOlder" class="list-status"><text>正在加载更早消息...</text></view>
				<view v-else-if="hasMore" class="list-status"><text>上拉加载更早消息</text></view>

				<view v-if="messages.length === 0 && !initialLoading && !sending" class="message-row">
					<view class="ai-avatar">
						<image class="ai-avatar-icon" src="/static/icons/ic-bot-avatar.svg" mode="aspectFit"></image>
					</view>
					<view class="message-bubble ai-bubble">
						<text class="message-text">说说你的伤痛或康复目标，我来帮你</text>
					</view>
				</view>

				<view v-if="messages.length === 0 && topics.length === 0 && !initialLoading && !sending" class="welcome-card">
					<image class="welcome-illustration" src="/static/icons/ic-heart-beat.svg" mode="aspectFit"></image>
					<text class="welcome-title">开始你的第一次对话</text>
					<text class="welcome-description">在下方输入框描述你的伤痛或康复目标，我会为你匹配康复方案</text>
					<view class="guide-row">
						<image class="guide-arrow" src="/static/icons/ic-down-arrow.svg" mode="aspectFit"></image>
						<text class="guide-text">直接输入，或点选下方常见问题</text>
					</view>
				</view>

				<view v-if="messages.length === 0 && !initialLoading && !sending" class="quick-panel">
					<text class="quick-question-label">你可以这样问我</text>
					<view class="quick-question-list">
						<view v-for="(question, index) in quickQuestions" :key="index" class="quick-question-chip" @click="askQuickQuestion(question)">
							<text class="quick-question-text">{{ question }}</text>
						</view>
					</view>
				</view>

				<view v-for="(item, index) in messages" v-show="item.visible" :key="item.id + '-' + index" class="message-row" :class="{ 'message-row-user': item.role === 'user' }">
					<view v-if="item.role === 'assistant'" class="ai-avatar">
						<image class="ai-avatar-icon" src="/static/icons/ic-bot-avatar.svg" mode="aspectFit"></image>
					</view>
					<view class="message-bubble" :class="item.role === 'user' ? 'user-bubble' : 'ai-bubble'">
						<text class="message-text" :class="{ 'user-message-text': item.role === 'user' }">{{ item.content }}</text>
						<view v-if="item.course != null" class="course-card">
							<view class="course-card-head">
								<view class="course-tag-row">
									<view class="course-tag"><text>{{ item.course.tagName }}</text></view>
									<view class="course-tag course-tag-stage"><text>{{ item.course.stageTitle }}</text></view>
								</view>
								<text class="course-title">{{ item.course.title }}</text>
								<text v-if="item.course.dictionaryText.length > 0" class="course-dictionary">{{ item.course.dictionaryText }}</text>
							</view>
							<view v-if="!item.course.unlocked" class="unlock-mask">
								<view class="lock-badge">
									<view class="lock-ring"></view>
									<view class="lock-body"><view class="lock-hole"></view></view>
								</view>
								<text class="unlock-title">解锁查看完整康复方案</text>
								<text class="unlock-subtitle">完整阶段安排 · 动作图文详解 · 视频跟练</text>
								<view class="unlock-button" @click="onUnlockTap(item.course)">
									<text class="unlock-button-text">{{ item.course.unlockButtonText }}</text>
								</view>
							</view>
							<view v-else class="unlocked-body">
								<view class="unlocked-current-stage">
									<text class="unlocked-current-kicker">本次解锁阶段</text>
									<text class="unlocked-current-title">{{ item.course.stageTitle }}</text>
									<text v-if="item.course.stageIndexText.length > 0" class="unlocked-current-meta">{{ item.course.stageIndexText }}</text>
									<text v-if="item.course.stageRemark.length > 0" class="unlocked-current-remark">{{ item.course.stageRemark }}</text>
								</view>
								<view class="unlocked-actions">
									<view class="unlocked-action unlocked-action-contact" @click="onContactCoachTap(item.course)">
										<image class="unlocked-action-icon" src="/static/icons/ic-online-message.svg" mode="aspectFit"></image>
										<text class="unlocked-action-text">联系康复师</text>
									</view>
									<view class="unlocked-action unlocked-action-plan" @click="onViewCourseTap(item.course)">
										<text class="unlocked-action-text unlocked-action-text-plan">查看完整方案</text>
									</view>
								</view>
							</view>
						</view>
						<view v-if="item.streaming" class="stream-cursor"></view>
						<text v-if="item.pending" class="message-status">发送中</text>
					</view>
					<view v-if="item.role === 'user'" class="user-avatar"><text class="user-avatar-text">我</text></view>
				</view>

				<view v-if="sending && waitingFirstToken" class="message-row">
					<view class="ai-avatar">
						<image class="ai-avatar-icon" src="/static/icons/ic-bot-avatar.svg" mode="aspectFit"></image>
					</view>
					<view class="message-bubble ai-bubble thinking-bubble">
						<text class="thinking-text">正在分析你的康复需求</text>
						<view class="thinking-dots">
							<view class="thinking-dot dot-one"></view>
							<view class="thinking-dot dot-two"></view>
							<view class="thinking-dot dot-three"></view>
						</view>
					</view>
				</view>

				<view id="chat-bottom" class="chat-bottom-space"></view>
			</view>
		</scroll-view>

		<view class="input-bar">
			<view class="input-box">
				<input
					class="chat-input"
					:value="message"
					:disabled="sending"
					placeholder="描述你的伤痛或康复目标…"
					placeholder-class="chat-input-placeholder"
					confirm-type="send"
					@input="onMessageInput"
					@confirm="sendMessage"
				/>
			</view>
			<view class="send-button" :class="{ 'send-button-disabled': sending }" @click="sendMessage">
				<image class="send-image" src="/static/icons/ic-send.svg" mode="aspectFit"></image>
			</view>
		</view>

		<view
			v-if="searchFabReady && !prescriptionFilterVisible"
			class="types-search-fab"
			:class="{ 'types-search-fab-snap': !searchFabDragging, 'types-search-fab-pressed': searchFabDragging }"
			:style="{ left: searchFabLeft + 'px', top: searchFabTop + 'px' }"
			hover-class="none"
			@click.stop="onTypesSearchTap"
			@touchstart.stop="onTypesSearchTouchStart"
			@touchmove.stop.prevent="onTypesSearchTouchMove"
			@touchend.stop="onTypesSearchTouchEnd"
			@touchcancel.stop="onTypesSearchTouchCancel"
		>
			<image class="types-search-fab-image" src="/static/icons/ic-types-search.svg" mode="aspectFit"></image>
		</view>

		<view v-if="prescriptionFilterVisible" class="prescription-filter-page">
			<view class="prescription-filter-status" :style="{ height: statusBarHeight + 'px' }"></view>
			<view class="prescription-filter-header">
				<view class="prescription-filter-back" @click="closePrescriptionFilter">
					<text class="prescription-filter-back-text">‹</text>
				</view>
				<text class="prescription-filter-title">分类检索</text>
			</view>

			<scroll-view class="prescription-filter-scroll" scroll-y>
					<view class="prescription-filter-content">
						<view class="prescription-filter-group">
							<view class="prescription-filter-group-head">
								<text class="prescription-filter-group-title">复健类型</text>
								<view class="prescription-filter-reset" @click="resetPrescriptionFilter">
									<text class="prescription-filter-reset-text">重置</text>
								</view>
							</view>
							<view v-if="prescriptionTagsLoading" class="prescription-filter-state">
								<text class="prescription-filter-state-text">正在加载标签...</text>
							</view>
							<view v-else-if="prescriptionTags.length === 0" class="prescription-filter-state">
								<text class="prescription-filter-state-text">暂无可选标签</text>
							</view>
							<view v-else class="prescription-filter-chips">
								<view
									v-for="tag in prescriptionTags"
									:key="tag.id"
									class="prescription-filter-chip"
									:class="{ 'prescription-filter-chip-active': selectedPrescriptionTagId === tag.id }"
									@click="selectPrescriptionTag(tag)"
								>
									<text class="prescription-filter-chip-text" :class="{ 'prescription-filter-chip-text-active': selectedPrescriptionTagId === tag.id }">{{ tag.title }}</text>
								</view>
							</view>
						</view>

					<template v-if="selectedPrescriptionTagId.length > 0">
						<view v-if="prescriptionDictionariesLoading" class="prescription-filter-state">
							<text class="prescription-filter-state-text">正在加载处方字典...</text>
						</view>
						<view v-else-if="prescriptionDictionaries.length === 0" class="prescription-filter-state">
							<text class="prescription-filter-state-text">该标签下暂无处方字典</text>
						</view>
						<template v-else>
							<view v-for="dictionary in prescriptionDictionaries" :key="dictionary.id" class="prescription-filter-group">
								<text class="prescription-filter-group-title">{{ dictionary.name }}</text>
								<view class="prescription-filter-chips">
									<view
										v-for="item in dictionary.items"
										:key="item.id"
										class="prescription-filter-chip"
										:class="{ 'prescription-filter-chip-active': isPrescriptionItemSelected(item.id) }"
										@click="selectPrescriptionItem(dictionary, item)"
									>
										<text class="prescription-filter-chip-text" :class="{ 'prescription-filter-chip-text-active': isPrescriptionItemSelected(item.id) }">{{ item.name }}</text>
									</view>
								</view>
							</view>
						</template>
					</template>
				</view>
			</scroll-view>

			<view class="prescription-filter-action-bar">
				<view
					class="prescription-filter-submit"
					:class="{ 'prescription-filter-submit-disabled': prescriptionActionDisabled }"
					@click="confirmPrescriptionFilter"
				>
					<text class="prescription-filter-submit-text">{{ prescriptionActionText }}</text>
				</view>
				<view
					class="prescription-filter-search-button"
					:class="{ 'prescription-filter-search-button-disabled': prescriptionSearchDisabled }"
					@click="runPrescriptionSearch"
				>
					<image class="prescription-filter-search-image" src="/static/icons/ic-types-search-in.svg" mode="aspectFit"></image>
				</view>
			</view>
		</view>

		<view v-if="topicDrawerVisible" class="topic-mask" @click="closeTopicDrawer">
			<view class="topic-panel" @click.stop>
				<view class="topic-panel-header">
					<view class="topic-panel-title-wrap">
						<text class="topic-panel-title">对话话题</text>
						<text class="topic-panel-subtitle">每个话题独立保存上下文</text>
					</view>
					<view class="topic-close" @click="closeTopicDrawer">
						<text class="topic-close-text">关闭</text>
					</view>
				</view>
				<view class="new-topic-button" @click="createNewTopic(false)">
					<text class="new-topic-button-text">+ 新建话题</text>
				</view>
				<scroll-view class="topic-list-scroll" scroll-y>
					<view
						v-for="topic in topics"
						:key="topic.id"
						class="topic-row"
						:class="{ 'topic-row-active': topic.id === sessionId }"
						@click="enterTopic(topic)"
					>
						<view class="topic-copy">
							<text class="topic-title">{{ topic.title }}</text>
							<text class="topic-meta">{{ topic.messageCount }} 条消息 · {{ topic.timeText }}</text>
						</view>
						<view class="topic-delete" @click.stop="confirmDeleteTopic(topic)">
							<text class="topic-delete-text">删除</text>
						</view>
					</view>
					<view v-if="topics.length === 0 && !loadingTopics" class="topic-empty">
						<text class="topic-empty-text">还没有历史话题</text>
					</view>
					<view v-if="loadingTopics" class="topic-empty">
						<text class="topic-empty-text">正在加载...</text>
					</view>
				</scroll-view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { hasLocalToken } from '../../common/auth'
	import { PrescriptionFilterDictionary, PrescriptionFilterItem, PrescriptionFilterTag } from '../../common/prescription-filter'
	import { RehabChatCourse, RehabChatMessage, RehabChatTopic } from '../../common/rehab-chat'
	import { del, get, post, postStream } from '../../common/request'

	const statusBarHeight = ref(24)
	const message = ref('')
	const messages = ref<RehabChatMessage[]>([])
	const topics = ref<RehabChatTopic[]>([])
	const sessionId = ref('')
	const currentTopicTitle = ref('新话题')
	const nextBefore = ref('')
	const hasMore = ref(false)
	const sending = ref(false)
	const loadingOlder = ref(false)
	const loadingLatest = ref(false)
	const loadingTopics = ref(false)
	const topicDrawerVisible = ref(false)
	const initialLoading = ref(true)
	const waitingFirstToken = ref(false)
	const streamingMessageId = ref('')
	const pendingUserMessageId = ref('')
	const lastScrollAt = ref(0)
	const scrollTop = ref(0)
	const scrollIntoView = ref('')
	const searchFabReady = ref(false)
	const searchFabDragging = ref(false)
	const searchFabLeft = ref(0)
	const searchFabTop = ref(0)
	const prescriptionFilterVisible = ref(false)
	const prescriptionTags = ref<PrescriptionFilterTag[]>([])
	const prescriptionTagsLoading = ref(false)
	const prescriptionTagsLoaded = ref(false)
	const selectedPrescriptionTagId = ref('')
	const selectedPrescriptionTagTitle = ref('')
	const prescriptionDictionaries = ref<PrescriptionFilterDictionary[]>([])
	const prescriptionDictionariesLoading = ref(false)
	const selectedPrescriptionItemIds = ref<string[]>([])
	const matchedStageCount = ref(0)
	const matchedStageLoading = ref(false)
	const prescriptionSearchPerformed = ref(false)
	const searchedPrescriptionTagId = ref('')
	const searchedPrescriptionItemIds = ref<string[]>([])
	const searchedPrescriptionLabels = ref<string[]>([])
	const quickQuestions = ref<string[]>([
		'跑步膝痛怎么恢复',
		'肩颈酸痛怎么缓解',
		'久坐腰背不适',
		'术后力量怎么练'
	])
	const SEARCH_FAB_SIZE = 52
	const SEARCH_FAB_EDGE = 16
	const SEARCH_FAB_INPUT_GAP = 16
	const INPUT_BAR_HEIGHT = 56
	let searchFabViewportWidth = 0
	let searchFabViewportHeight = 0
	let searchFabMinTop = 0
	let searchFabMaxTop = 0
	let searchFabTouchStartX = 0
	let searchFabTouchStartY = 0
	let searchFabTouchStartLeft = 0
	let searchFabTouchStartTop = 0
	let searchFabTouchMoved = false
	let dictionaryRequestVersion = 0
	let matchCountRequestVersion = 0
	const prescriptionActionText = computed(() => {
		if (matchedStageLoading.value) {
			return '正在检索...'
		}
		if (!prescriptionSearchPerformed.value) {
			return '请选择检索条件'
		}
		if (matchedStageCount.value === 0) {
			return '未检索到匹配的方案'
		}
		return '查看 ' + matchedStageCount.value.toString() + ' 个匹配方案'
	})
	const prescriptionActionDisabled = computed(() => {
		return matchedStageLoading.value || !prescriptionSearchPerformed.value || matchedStageCount.value === 0
	})
	const prescriptionSearchDisabled = computed(() => {
		return selectedPrescriptionTagId.value.length === 0 || matchedStageLoading.value
	})

	onLoad(() => {
		const sys = uni.getSystemInfoSync()
		statusBarHeight.value = sys.statusBarHeight
		initSearchFab(sys.windowWidth, sys.windowHeight)
	})

	onShow(() => {
		if (!hasLocalToken()) {
			initialLoading.value = false
			return
		}
		if (sending.value) {
			return
		}
		if (sessionId.value.length > 0) {
			loadTopicMessages(sessionId.value)
		} else {
			loadLatestSession()
		}
	})

	function parseMessageList (data: UTSJSONObject): RehabChatMessage[] {
		const result: RehabChatMessage[] = []
		const list = data.getArray<UTSJSONObject>('messages')
		if (list == null) {
			return result
		}
		for (let i = 0; i < list.length; i++) {
			const item = new RehabChatMessage()
			item.initFromJSON(list[i])
			result.push(item)
		}
		return result
	}

	function loadLatestSession (): void {
		if (loadingLatest.value) {
			return
		}
		if (!hasLocalToken()) {
			initialLoading.value = false
			return
		}
		loadingLatest.value = true
		get('/rehab_chat/latest', (res) => {
			loadingLatest.value = false
			initialLoading.value = false
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const data = res.getJSON('data')
			if (data == null) {
				return
			}
			const session = data.getJSON('session')
			if (session == null) {
				sessionId.value = ''
				currentTopicTitle.value = '新话题'
				messages.value = []
				hasMore.value = false
				nextBefore.value = ''
				loadTopics()
				return
			}
			sessionId.value = session.getString('id') ?? ''
			currentTopicTitle.value = session.getString('title') ?? '新话题'
			messages.value = parseMessageList(data)
			hasMore.value = data.getBoolean('has_more') ?? false
			nextBefore.value = data.getString('next_before') ?? ''
			loadTopics()
			scrollToBottom()
		}, () => {
			loadingLatest.value = false
			initialLoading.value = false
		})
	}

	function loadTopics (): void {
		if (!hasLocalToken() || loadingTopics.value) {
			return
		}
		loadingTopics.value = true
		get('/rehab_chat/topics', (res) => {
			loadingTopics.value = false
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const data = res.getJSON('data')
			if (data == null) {
				return
			}
			const list = data.getArray<UTSJSONObject>('topics')
			const parsed: RehabChatTopic[] = []
			if (list != null) {
				for (let i = 0; i < list.length; i++) {
					const topic = new RehabChatTopic()
					topic.initFromJSON(list[i])
					parsed.push(topic)
				}
			}
			topics.value = parsed
		}, () => {
			loadingTopics.value = false
		})
	}

	function loadOlderMessages (): void {
		if (loadingOlder.value || !hasMore.value || sessionId.value.length === 0 || nextBefore.value.length === 0) {
			return
		}
		loadingOlder.value = true
		const url = '/rehab_chat/topics/' + encodeURIComponent(sessionId.value) + '/messages?before=' + encodeURIComponent(nextBefore.value) + '&pageSize=20'
		get(url, (res) => {
			loadingOlder.value = false
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const data = res.getJSON('data')
			if (data == null) {
				return
			}
			const older = parseMessageList(data)
			if (older.length > 0) {
				const merged: RehabChatMessage[] = []
				for (let i = 0; i < older.length; i++) {
					merged.push(older[i])
				}
				for (let i = 0; i < messages.value.length; i++) {
					merged.push(messages.value[i])
				}
				messages.value = merged
				nextBefore.value = older[0].createdAt
				scrollTop.value = scrollTop.value + 520
			}
			hasMore.value = data.getBoolean('has_more') ?? false
		}, () => {
			loadingOlder.value = false
		})
	}

	function onMessageInput (event: UniEvent): void {
		message.value = event.detail.value as string
	}

	function initSearchFab (viewportWidth: number, viewportHeight: number): void {
		searchFabViewportWidth = viewportWidth
		searchFabViewportHeight = viewportHeight
		searchFabMinTop = statusBarHeight.value + 64
		searchFabMaxTop = viewportHeight - INPUT_BAR_HEIGHT - SEARCH_FAB_INPUT_GAP - SEARCH_FAB_SIZE
		searchFabLeft.value = viewportWidth - SEARCH_FAB_EDGE - SEARCH_FAB_SIZE
		searchFabTop.value = Math.max(searchFabMinTop, searchFabMaxTop)
		searchFabReady.value = true
	}

	function onTypesSearchTouchStart (event: UniTouchEvent): void {
		if (event.touches.length === 0) {
			return
		}
		const touch = event.touches[0]
		searchFabTouchStartX = touch.clientX
		searchFabTouchStartY = touch.clientY
		searchFabTouchStartLeft = searchFabLeft.value
		searchFabTouchStartTop = searchFabTop.value
		searchFabTouchMoved = false
		searchFabDragging.value = true
	}

	function onTypesSearchTouchMove (event: UniTouchEvent): void {
		if (!searchFabDragging.value || event.touches.length === 0) {
			return
		}
		const touch = event.touches[0]
		const deltaX = touch.clientX - searchFabTouchStartX
		const deltaY = touch.clientY - searchFabTouchStartY
		if (Math.abs(deltaX) > 3 || Math.abs(deltaY) > 3) {
			searchFabTouchMoved = true
		}
		searchFabLeft.value = clampSearchFabLeft(searchFabTouchStartLeft + deltaX)
		searchFabTop.value = clampSearchFabTop(searchFabTouchStartTop + deltaY)
	}

	function onTypesSearchTouchEnd (): void {
		if (!searchFabDragging.value) {
			return
		}
		const shouldOpen = !searchFabTouchMoved
		searchFabDragging.value = false
		snapSearchFabToEdge()
		if (shouldOpen) {
			openPrescriptionFilter()
		}
	}

	function onTypesSearchTouchCancel (): void {
		if (!searchFabDragging.value) {
			return
		}
		searchFabDragging.value = false
		searchFabTouchMoved = false
		snapSearchFabToEdge()
	}

	function snapSearchFabToEdge (): void {
		const fabCenter = searchFabLeft.value + SEARCH_FAB_SIZE / 2
		if (fabCenter < searchFabViewportWidth / 2) {
			searchFabLeft.value = SEARCH_FAB_EDGE
		} else {
			searchFabLeft.value = searchFabViewportWidth - SEARCH_FAB_EDGE - SEARCH_FAB_SIZE
		}
	}

	function clampSearchFabLeft (value: number): number {
		const maxLeft = searchFabViewportWidth - SEARCH_FAB_EDGE - SEARCH_FAB_SIZE
		return Math.max(SEARCH_FAB_EDGE, Math.min(maxLeft, value))
	}

	function clampSearchFabTop (value: number): number {
		return Math.max(searchFabMinTop, Math.min(searchFabMaxTop, value))
	}

	function onTypesSearchTap (): void {
		if (searchFabTouchMoved) {
			searchFabTouchMoved = false
			return
		}
		openPrescriptionFilter()
	}

	function openPrescriptionFilter (): void {
		prescriptionFilterVisible.value = true
		if (!prescriptionTagsLoaded.value) {
			loadPrescriptionTags()
		}
	}

	function closePrescriptionFilter (): void {
		prescriptionFilterVisible.value = false
	}

	function loadPrescriptionTags (): void {
		if (prescriptionTagsLoading.value) {
			return
		}
		prescriptionTagsLoading.value = true
		get('/prescription_tag/mini_find?status=1', (res) => {
			prescriptionTagsLoading.value = false
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const items = res.getArray<UTSJSONObject>('data')
			const parsed: PrescriptionFilterTag[] = []
			if (items != null) {
				for (let i = 0; i < items.length; i++) {
					const tag = new PrescriptionFilterTag()
					tag.initFromJSON(items[i])
					parsed.push(tag)
				}
			}
			prescriptionTags.value = parsed
			prescriptionTagsLoaded.value = true
		}, () => {
			prescriptionTagsLoading.value = false
		})
	}

	function selectPrescriptionTag (tag: PrescriptionFilterTag): void {
		if (selectedPrescriptionTagId.value === tag.id) {
			return
		}
		selectedPrescriptionTagId.value = tag.id
		selectedPrescriptionTagTitle.value = tag.title
		selectedPrescriptionItemIds.value = []
		prescriptionDictionaries.value = []
		loadPrescriptionDictionaries(tag.id)
	}

	function loadPrescriptionDictionaries (tagId: string): void {
		dictionaryRequestVersion += 1
		const version = dictionaryRequestVersion
		prescriptionDictionariesLoading.value = true
		get('/prescription_tag_dictionary/mini_find?prescription_tag_id=' + encodeURIComponent(tagId), (res) => {
			if (version !== dictionaryRequestVersion) {
				return
			}
			prescriptionDictionariesLoading.value = false
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const items = res.getArray<UTSJSONObject>('data')
			const parsed: PrescriptionFilterDictionary[] = []
			if (items != null) {
				for (let i = 0; i < items.length; i++) {
					const dictionary = new PrescriptionFilterDictionary()
					dictionary.initFromJSON(items[i])
					if (dictionary.items.length === 0) {
						continue
					}
					parsed.push(dictionary)
				}
			}
			prescriptionDictionaries.value = parsed
		}, () => {
			if (version === dictionaryRequestVersion) {
				prescriptionDictionariesLoading.value = false
			}
		})
	}

	function isPrescriptionItemSelected (itemId: string): boolean {
		for (let i = 0; i < selectedPrescriptionItemIds.value.length; i++) {
			if (selectedPrescriptionItemIds.value[i] === itemId) {
				return true
			}
		}
		return false
	}

	function selectPrescriptionItem (dictionary: PrescriptionFilterDictionary, item: PrescriptionFilterItem): void {
		const alreadySelected = isPrescriptionItemSelected(item.id)
		const next: string[] = []
		for (let i = 0; i < prescriptionDictionaries.value.length; i++) {
			const group = prescriptionDictionaries.value[i]
			if (group.id === dictionary.id) {
				continue
			}
			for (let j = 0; j < group.items.length; j++) {
				if (isPrescriptionItemSelected(group.items[j].id)) {
					next.push(group.items[j].id)
				}
			}
		}
		if (!alreadySelected) {
			next.push(item.id)
		}
		selectedPrescriptionItemIds.value = next
	}

	function invalidatePrescriptionSearch (): void {
		matchCountRequestVersion += 1
		prescriptionSearchPerformed.value = false
		matchedStageLoading.value = false
		matchedStageCount.value = 0
	}

	function runPrescriptionSearch (): void {
		if (prescriptionSearchDisabled.value) {
			if (selectedPrescriptionTagId.value.length === 0) {
				uni.showToast({
					title: '请先选择复健类型',
					icon: 'none'
				})
			}
			return
		}
		matchCountRequestVersion += 1
		const version = matchCountRequestVersion
		const searchTagId = selectedPrescriptionTagId.value
		const searchItemIds: string[] = []
		for (let i = 0; i < selectedPrescriptionItemIds.value.length; i++) {
			searchItemIds.push(selectedPrescriptionItemIds.value[i])
		}
		const searchLabels = buildSelectedPrescriptionLabels()
		prescriptionSearchPerformed.value = false
		matchedStageLoading.value = true
		matchedStageCount.value = 0
		let url = '/rehab_combination_course/mini_match?prescription_tag_id=' + encodeURIComponent(searchTagId)
		if (searchItemIds.length > 0) {
			let itemIds = ''
			for (let i = 0; i < searchItemIds.length; i++) {
				if (itemIds.length > 0) {
					itemIds += ','
				}
				itemIds += searchItemIds[i]
			}
			url += '&dictionary_item_ids=' + encodeURIComponent(itemIds)
		}
		get(url, (res) => {
			if (version !== matchCountRequestVersion) {
				return
			}
			matchedStageLoading.value = false
			if (res.getNumber('code', 0) !== 200) {
				uni.showToast({
					title: res.getString('message') ?? '检索失败',
					icon: 'none'
				})
				return
			}
			const data = res.getJSON('data')
			matchedStageCount.value = data == null ? 0 : data.getNumber('stage_count', 0)
			searchedPrescriptionTagId.value = searchTagId
			searchedPrescriptionItemIds.value = searchItemIds
			searchedPrescriptionLabels.value = searchLabels
			prescriptionSearchPerformed.value = true
		}, () => {
			if (version === matchCountRequestVersion) {
				matchedStageLoading.value = false
				uni.showToast({
					title: '检索失败，请稍后重试',
					icon: 'none'
				})
			}
		})
	}

	function resetPrescriptionFilter (): void {
		dictionaryRequestVersion += 1
		selectedPrescriptionTagId.value = ''
		selectedPrescriptionTagTitle.value = ''
		prescriptionDictionaries.value = []
		prescriptionDictionariesLoading.value = false
		selectedPrescriptionItemIds.value = []
		searchedPrescriptionTagId.value = ''
		searchedPrescriptionItemIds.value = []
		searchedPrescriptionLabels.value = []
		invalidatePrescriptionSearch()
	}

	function confirmPrescriptionFilter (): void {
		if (prescriptionActionDisabled.value) {
			return
		}
		if (!hasLocalToken()) {
			uni.showModal({
				title: '请先登录',
				content: '登录后才能查看匹配方案和课程解锁状态',
				showCancel: false,
				success: () => {
					uni.navigateTo({
						url: '/pages/login-guide/login-guide'
					})
				}
			})
			return
		}
		let itemIds = ''
		for (let i = 0; i < searchedPrescriptionItemIds.value.length; i++) {
			if (itemIds.length > 0) {
				itemIds += ','
			}
			itemIds += searchedPrescriptionItemIds.value[i]
		}
		let labels = ''
		for (let i = 0; i < searchedPrescriptionLabels.value.length; i++) {
			if (labels.length > 0) {
				labels += '|'
			}
			labels += searchedPrescriptionLabels.value[i]
		}
		uni.navigateTo({
			url: '/pages/prescription-results/prescription-results?prescriptionTagId=' + encodeURIComponent(searchedPrescriptionTagId.value)
				+ '&dictionaryItemIds=' + encodeURIComponent(itemIds)
				+ '&labels=' + encodeURIComponent(labels)
				+ '&count=' + matchedStageCount.value.toString()
		})
	}

	function buildSelectedPrescriptionLabels (): string[] {
		const labels: string[] = []
		if (selectedPrescriptionTagTitle.value.length > 0) {
			labels.push(selectedPrescriptionTagTitle.value)
		}
		for (let i = 0; i < prescriptionDictionaries.value.length; i++) {
			const dictionary = prescriptionDictionaries.value[i]
			for (let j = 0; j < dictionary.items.length; j++) {
				if (isPrescriptionItemSelected(dictionary.items[j].id)) {
					labels.push(dictionary.items[j].name)
				}
			}
		}
		return labels
	}

	function askQuickQuestion (question: string): void {
		message.value = question
		sendMessage()
	}

	function sendMessage (): void {
		if (sending.value) {
			return
		}
		const content = message.value.trim()
		if (content.length === 0) {
			uni.showToast({
				title: '请先描述你的康复问题',
				icon: 'none'
			})
			return
		}
		if (content.length > 300) {
			uni.showToast({
				title: '单次描述请控制在300字以内',
				icon: 'none'
			})
			return
		}
		if (!hasLocalToken()) {
			uni.showToast({
				title: '请先登录后再咨询',
				icon: 'none'
			})
			uni.navigateTo({ url: '/pages/login-guide/login-guide' })
			return
		}

		const now = Date.now().toString()
		const tempId = 'temp-' + now
		const tempMessage = new RehabChatMessage()
		tempMessage.id = tempId
		tempMessage.role = 'user'
		tempMessage.content = content
		tempMessage.createdAt = new Date().toISOString()
		tempMessage.timeText = '刚刚'
		tempMessage.pending = true
		messages.value.push(tempMessage)

		const assistantId = 'stream-' + now
		const assistantPlaceholder = new RehabChatMessage()
		assistantPlaceholder.id = assistantId
		assistantPlaceholder.role = 'assistant'
		assistantPlaceholder.content = ''
		assistantPlaceholder.createdAt = new Date().toISOString()
		assistantPlaceholder.timeText = '刚刚'
		assistantPlaceholder.visible = false
		assistantPlaceholder.streaming = true
		messages.value.push(assistantPlaceholder)

		pendingUserMessageId.value = tempId
		streamingMessageId.value = assistantId
		message.value = ''
		sending.value = true
		waitingFirstToken.value = true
		scrollToBottom()

		const body = new UTSJSONObject()
		body.set('content', content)
		if (sessionId.value.length > 0) {
			body.set('topic_id', sessionId.value)
		}
		postStream('/rehab_chat/message/stream', body, handleStreamEvent, (msg) => {
			handleStreamFailure(msg)
		}, () => {
			if (sending.value) {
				handleStreamFailure('连接已结束，请稍后重试')
			}
		})
	}

	function handleStreamEvent (event: string, payload: UTSJSONObject): void {
		if (event === 'start') {
			const session = payload.getJSON('session')
			if (session != null) {
				sessionId.value = session.getString('id') ?? sessionId.value
				currentTopicTitle.value = session.getString('title') ?? currentTopicTitle.value
			}
			const userMessage = payload.getJSON('user_message')
			if (userMessage != null) {
				replacePendingUserMessage(userMessage)
			}
			return
		}
		if (event === 'delta') {
			const chunk = payload.getString('content') ?? ''
			appendStreamDelta(chunk)
			return
		}
		if (event === 'replace') {
			replaceStreamingContent(payload.getString('content') ?? '')
			return
		}
		if (event === 'message') {
			finalizeStreamMessage(payload)
			return
		}
		if (event === 'done') {
			sending.value = false
			waitingFirstToken.value = false
			finishStreamingMessage()
			loadTopics()
			scrollToBottom()
			return
		}
		if (event === 'error') {
			handleStreamFailure(payload.getString('message') ?? '发送失败')
			return
		}
		if (event === 'fallback') {
			handleFallbackResult(payload)
		}
	}

	function appendStreamDelta (chunk: string): void {
		if (chunk.length === 0) {
			return
		}
		const index = findMessageIndex(streamingMessageId.value)
		if (index < 0) {
			return
		}
		waitingFirstToken.value = false
		messages.value[index].visible = true
		messages.value[index].content += chunk
		const now = Date.now()
		if (now - lastScrollAt.value > 120) {
			lastScrollAt.value = now
			scrollToBottom()
		}
	}

	function replaceStreamingContent (content: string): void {
		const index = findMessageIndex(streamingMessageId.value)
		if (index >= 0) {
			messages.value[index].visible = true
			messages.value[index].content = content
		}
		waitingFirstToken.value = false
	}

	function finalizeStreamMessage (payload: UTSJSONObject): void {
		const session = payload.getJSON('session')
		if (session != null) {
			sessionId.value = session.getString('id') ?? sessionId.value
			currentTopicTitle.value = session.getString('title') ?? currentTopicTitle.value
		}
		const assistantJson = payload.getJSON('assistant_message')
		if (assistantJson == null) {
			return
		}
		const finalMessage = new RehabChatMessage()
		finalMessage.initFromJSON(assistantJson)
		const index = findMessageIndex(streamingMessageId.value)
		if (index >= 0) {
			messages.value[index] = finalMessage
		} else {
			messages.value.push(finalMessage)
		}
		waitingFirstToken.value = false
		scrollToBottom()
	}

	function finishStreamingMessage (): void {
		const index = findMessageIndex(streamingMessageId.value)
		if (index >= 0) {
			messages.value[index].streaming = false
			if (messages.value[index].content.length === 0) {
				messages.value[index].content = '我暂时没有生成完整回复，请再试一次。'
				messages.value[index].visible = true
			}
		}
	}

	function handleStreamFailure (messageText: string): void {
		sending.value = false
		waitingFirstToken.value = false
		const userIndex = findMessageIndex(pendingUserMessageId.value)
		if (userIndex >= 0) {
			messages.value[userIndex].pending = false
			messages.value[userIndex].matchStatus = 'failed'
		}
		const assistantIndex = findMessageIndex(streamingMessageId.value)
		if (assistantIndex >= 0) {
			messages.value[assistantIndex].visible = true
			messages.value[assistantIndex].streaming = false
			messages.value[assistantIndex].content = messageText
		}
		uni.showToast({
			title: messageText,
			icon: 'none'
		})
	}

	function handleFallbackResult (res: UTSJSONObject): void {
		sending.value = false
		waitingFirstToken.value = false
		const code = res.getNumber('code', 0)
		if (code !== 200) {
			handleStreamFailure(res.getString('message') ?? '发送失败')
			return
		}
		const data = res.getJSON('data')
		if (data == null) {
			handleStreamFailure('发送失败')
			return
		}
		const session = data.getJSON('session')
		if (session != null) {
			sessionId.value = session.getString('id') ?? sessionId.value
			currentTopicTitle.value = session.getString('title') ?? currentTopicTitle.value
		}
		const userMessage = data.getJSON('user_message')
		if (userMessage != null) {
			replacePendingUserMessage(userMessage)
		}
		const assistantJson = data.getJSON('assistant_message')
		if (assistantJson != null) {
			finalizeStreamMessage(data)
		}
	}

	function replacePendingUserMessage (userMessage: UTSJSONObject): void {
		const index = findMessageIndex(pendingUserMessageId.value)
		if (index < 0) {
			return
		}
		const finalUserMessage = new RehabChatMessage()
		finalUserMessage.initFromJSON(userMessage)
		messages.value[index] = finalUserMessage
		pendingUserMessageId.value = finalUserMessage.id
	}

	function findMessageIndex (id: string): number {
		for (let i = 0; i < messages.value.length; i++) {
			if (messages.value[i].id === id) {
				return i
			}
		}
		return -1
	}

	function scrollToBottom (): void {
		scrollIntoView.value = ''
		setTimeout(() => {
			scrollIntoView.value = 'chat-bottom'
		}, 20)
	}

	function openTopicDrawer (): void {
		if (sending.value) {
			uni.showToast({
				title: '回复生成中，请稍后再切换',
				icon: 'none'
			})
			return
		}
		topicDrawerVisible.value = true
		loadTopics()
	}

	function closeTopicDrawer (): void {
		topicDrawerVisible.value = false
	}

	function createNewTopic (silent: boolean): void {
		if (sending.value) {
			return
		}
		if (!silent && sessionId.value.length > 0 && currentTopicTitle.value === '新话题' && messages.value.length === 0) {
			topicDrawerVisible.value = false
			return
		}
		const body = new UTSJSONObject()
		post('/rehab_chat/topics', body, (res) => {
			if (res.getNumber('code', 0) !== 200) {
				if (!silent) {
					uni.showToast({
						title: res.getString('message') ?? '创建话题失败',
						icon: 'none'
					})
				}
				return
			}
			const data = res.getJSON('data')
			const topic = data == null ? null : data.getJSON('topic')
			if (topic == null) {
				return
			}
			sessionId.value = topic.getString('id') ?? ''
			currentTopicTitle.value = topic.getString('title') ?? '新话题'
			messages.value = []
			hasMore.value = false
			nextBefore.value = ''
			topicDrawerVisible.value = false
			loadTopics()
			if (!silent) {
				uni.showToast({
					title: '已新建话题',
					icon: 'none'
				})
			}
		}, (message) => {
			if (!silent) {
				uni.showToast({
					title: message,
					icon: 'none'
				})
			}
		})
	}

	function enterTopic (topic: RehabChatTopic): void {
		if (sending.value) {
			return
		}
		if (topic.id === sessionId.value) {
			topicDrawerVisible.value = false
			return
		}
		sessionId.value = topic.id
		currentTopicTitle.value = topic.title
		messages.value = []
		hasMore.value = false
		nextBefore.value = ''
		topicDrawerVisible.value = false
		loadTopicMessages(topic.id)
	}

	function loadTopicMessages (topicId: string): void {
		initialLoading.value = true
		const url = '/rehab_chat/topics/' + encodeURIComponent(topicId) + '/messages?pageSize=20'
		get(url, (res) => {
			initialLoading.value = false
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const data = res.getJSON('data')
			if (data == null) {
				return
			}
			const session = data.getJSON('session')
			if (session != null) {
				currentTopicTitle.value = session.getString('title') ?? currentTopicTitle.value
			}
			messages.value = parseMessageList(data)
			hasMore.value = data.getBoolean('has_more') ?? false
			nextBefore.value = data.getString('next_before') ?? ''
			scrollToBottom()
		}, () => {
			initialLoading.value = false
		})
	}

	function confirmDeleteTopic (topic: RehabChatTopic): void {
		if (sending.value) {
			return
		}
		uni.showModal({
			title: '删除话题',
			content: '删除后该话题下的对话记录会一并删除，确定吗？',
			success: (result) => {
				if (!result.confirm) {
					return
				}
				deleteTopic(topic)
			}
		})
	}

	function deleteTopic (topic: RehabChatTopic): void {
		del('/rehab_chat/topics/' + encodeURIComponent(topic.id), (res) => {
			if (res.getNumber('code', 0) !== 200) {
				uni.showToast({
					title: res.getString('message') ?? '删除失败',
					icon: 'none'
				})
				return
			}
			topicDrawerVisible.value = false
			if (topic.id === sessionId.value) {
				sessionId.value = ''
				messages.value = []
				currentTopicTitle.value = '新话题'
				loadLatestSession()
			}
			loadTopics()
		}, (message) => {
			uni.showToast({
				title: message,
				icon: 'none'
			})
		})
	}

	function onUnlockTap (course: RehabChatCourse): void {
		uni.navigateTo({
			url: '/pages/rehab-unlock/rehab-unlock?courseId=' + encodeURIComponent(course.id)
				+ '&stageId=' + encodeURIComponent(course.stageId)
		})
	}

	function onContactCoachTap (course: RehabChatCourse | null): void {
		let url = '/pages/support-chat/support-chat'
		if (course != null && course.stageId.length > 0) {
			url += '?courseId=' + encodeURIComponent(course.id)
				+ '&stageId=' + encodeURIComponent(course.stageId)
		}
		uni.navigateTo({ url })
	}

	function onViewCourseTap (course: RehabChatCourse | null): void {
		if (course == null || course.stageId.length === 0) {
			uni.showToast({
				title: '方案信息不完整，请稍后重试',
				icon: 'none'
			})
			return
		}
		uni.navigateTo({
			url: '/pages/rehab-plan/rehab-plan?stageId=' + encodeURIComponent(course.stageId)
				+ '&courseTitle=' + encodeURIComponent(course.title)
		})
	}
</script>

<style lang="scss">
	.page {
		flex: 1;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: #FFFFFF;
	}

	.nav-space {
		background: #FFFFFF;
	}

	.assistant-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		height: 52px;
		padding: 0 16px;
		box-sizing: border-box;
		background: #FFFFFF;
	}

	.assistant-copy {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.assistant-title {
		font-size: 20px;
		font-weight: 700;
		line-height: 28px;
		color: #1A1D24;
	}

	.assistant-subtitle {
		display: block;
		max-width: 220px;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: 11px;
		font-weight: 400;
		line-height: 16px;
		color: #9CA3AF;
	}

	.topic-toolbar {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 8px;
		padding: 0 16px 10px;
		box-sizing: border-box;
		background: #FFFFFF;
		border-bottom: 1px solid #F1F2F4;
	}

	.topic-toolbar-main {
		flex: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 10px;
		height: 40px;
		padding: 0 12px;
		box-sizing: border-box;
		border-radius: 14px;
		background: #F7F8FA;
		min-width: 0;
	}

	.topic-toolbar-icon {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}

	.topic-toolbar-copy {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
	}

	.topic-toolbar-label {
		font-size: 10px;
		line-height: 14px;
		color: #9CA3AF;
	}

	.topic-toolbar-title {
		display: block;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: 13px;
		font-weight: 600;
		line-height: 18px;
		color: #1A1D24;
	}

	.topic-toolbar-action {
		flex-shrink: 0;
		font-size: 11px;
		font-weight: 500;
		color: #FF6B35;
	}

	.topic-toolbar-new {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 66px;
		height: 40px;
		flex-shrink: 0;
		border-radius: 14px;
		background: #FF6B35;
	}

	.topic-toolbar-new-text {
		font-size: 12px;
		font-weight: 600;
		color: #FFFFFF;
	}

	.chat-scroll {
		flex: 1;
		height: 0;
		background: #FFFFFF;
	}

	.message-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 8px 16px 16px;
		box-sizing: border-box;
	}

	.list-status {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 6px 0;
		font-size: 11px;
		color: #9CA3AF;
	}

	.welcome-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		padding: 24px 24px 20px;
		box-sizing: border-box;
		background: #F7F8FA;
		border-radius: 14px;
	}

	.welcome-illustration {
		width: 72px;
		height: 72px;
	}

	.welcome-title {
		font-size: 16px;
		font-weight: 700;
		line-height: 22px;
		color: #1A1D24;
		text-align: center;
	}

	.welcome-description {
		display: block;
		width: 100%;
		font-size: 12px;
		font-weight: 400;
		line-height: 18px;
		color: #9CA3AF;
		text-align: center;
	}

	.guide-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 4px;
	}

	.guide-arrow {
		width: 12px;
		height: 12px;
	}

	.guide-text {
		font-size: 11px;
		font-weight: 500;
		line-height: 16px;
		color: #FF6B35;
	}

	.quick-panel {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding-top: 2px;
	}

	.quick-question-label {
		display: block;
		font-size: 11px;
		font-weight: 400;
		line-height: 16px;
		color: #9CA3AF;
	}

	.quick-question-list {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 8px;
	}

	.quick-question-chip {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 8px 12px;
		background: #FFFFFF;
		border: 1px solid #EDEFF2;
		border-radius: 999px;
	}

	.quick-question-text {
		font-size: 12px;
		font-weight: 400;
		line-height: 16px;
		color: #4B5563;
	}

	.message-row {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 8px;
		width: 100%;
		box-sizing: border-box;
	}

	.message-row-user {
		justify-content: flex-end;
	}

	.ai-avatar {
		width: 32px;
		height: 32px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 16px;
		background: transparent;
	}

	.ai-avatar-icon {
		width: 32px;
		height: 32px;
	}

	.user-avatar {
		width: 32px;
		height: 32px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 16px;
		background: #1A1D24;
	}

	.user-avatar-text {
		font-size: 12px;
		font-weight: 600;
		color: #FFFFFF;
	}

	.message-bubble {
		max-width: 282px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 12px;
		box-sizing: border-box;
		border-radius: 14px;
	}

	.ai-bubble {
		background: #F7F8FA;
	}

	.user-bubble {
		background: #FF6B35;
	}

	.message-text {
		display: block;
		font-size: 13px;
		font-weight: 400;
		line-height: 20px;
		color: #1A1D24;
		word-break: break-all;
	}

	.user-message-text {
		color: #FFFFFF;
	}

	.message-status {
		font-size: 10px;
		color: #9CA3AF;
	}

	.stream-cursor {
		width: 2px;
		height: 16px;
		border-radius: 1px;
		background: #FF6B35;
		animation: streamCursorBlink 0.8s infinite;
	}

	@keyframes streamCursorBlink {
		0%, 45% {
			opacity: 1;
		}
		46%, 100% {
			opacity: 0.15;
		}
	}

	.user-bubble .message-status {
		color: rgba(255, 255, 255, 0.75);
	}

	.course-card {
		position: relative;
		width: 258px;
		overflow: hidden;
		background: #FFFFFF;
		border: 1px solid #EDEFF2;
		border-radius: 12px;
	}

	.course-card-head {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 12px;
		box-sizing: border-box;
	}

	.course-tag-row {
		display: flex;
		flex-direction: row;
		gap: 6px;
	}

	.course-tag {
		padding: 3px 7px;
		border-radius: 999px;
		background: #FFF1EA;
		font-size: 10px;
		line-height: 14px;
		color: #FF6B35;
	}

	.course-tag-stage {
		background: #F2F4F7;
		color: #4B5563;
	}

	.course-title {
		font-size: 14px;
		font-weight: 700;
		line-height: 20px;
		color: #1A1D24;
	}

	.course-dictionary {
		font-size: 11px;
		line-height: 17px;
		color: #6B7280;
	}

	.course-stage-text {
		font-size: 11px;
		font-weight: 500;
		line-height: 16px;
		color: #FF6B35;
	}

	.unlock-mask {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: 16px 18px 18px;
		box-sizing: border-box;
		background: rgba(255, 255, 255, 0.94);
		border-top: 1px solid #FFE0D1;
	}

	.lock-badge {
		position: relative;
		width: 44px;
		height: 44px;
		border-radius: 22px;
		background: #FFF3EC;
	}

	.lock-ring {
		position: absolute;
		left: 15px;
		top: 10px;
		width: 13px;
		height: 12px;
		border: 2px solid #FF6B35;
		border-radius: 7px 7px 3px 3px;
		box-sizing: border-box;
	}

	.lock-body {
		position: absolute;
		left: 12px;
		top: 19px;
		width: 20px;
		height: 14px;
		border-radius: 4px;
		background: #FF6B35;
	}

	.lock-hole {
		position: absolute;
		left: 7px;
		top: 4px;
		width: 6px;
		height: 6px;
		border-radius: 3px;
		background: #FFFFFF;
	}

	.unlock-title {
		font-size: 14px;
		font-weight: 600;
		line-height: 20px;
		color: #1A1D24;
		text-align: center;
	}

	.unlock-subtitle {
		font-size: 11px;
		line-height: 16px;
		color: #9CA3AF;
		text-align: center;
	}

	.unlock-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 170px;
		height: 40px;
		margin-top: 2px;
		border-radius: 999px;
		background-color: #FF6B35;
		background-image: linear-gradient(135deg, #FF8A3D 0%, #FF5124 100%);
		box-shadow: 0 6px 14px rgba(255, 81, 36, 0.28);
	}

	.unlock-button-text {
		font-size: 14px;
		font-weight: 600;
		color: #FFFFFF;
	}

	.unlocked-body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 12px;
		box-sizing: border-box;
		background: #FFFFFF;
		border-top: 1px solid #EDEFF2;
	}

	.unlocked-current-stage {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 12px;
		border-radius: 10px;
		background: #FFF5EF;
	}

	.unlocked-current-kicker {
		font-size: 10px;
		line-height: 14px;
		color: #FF6B35;
	}

	.unlocked-current-title {
		font-size: 14px;
		font-weight: 700;
		line-height: 20px;
		color: #1A1D24;
	}

	.unlocked-current-meta {
		font-size: 11px;
		line-height: 16px;
		color: #6B7280;
	}

	.unlocked-current-remark {
		margin-top: 2px;
		font-size: 11px;
		line-height: 17px;
		color: #9CA3AF;
	}

	.unlocked-stage-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 8px;
		padding: 8px;
		border-radius: 9px;
		background: #F7F8FA;
	}

	.unlocked-stage-row-current {
		background: #FFF5EF;
	}

	.unlocked-stage-dot {
		width: 8px;
		height: 8px;
		flex-shrink: 0;
		border-radius: 4px;
		background: #D1D5DB;
	}

	.unlocked-stage-dot-current {
		background: #FF6B35;
	}

	.unlocked-stage-copy {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.unlocked-stage-title {
		font-size: 12px;
		font-weight: 600;
		line-height: 17px;
		color: #1A1D24;
	}

	.unlocked-stage-meta {
		font-size: 10px;
		line-height: 14px;
		color: #9CA3AF;
	}

	.unlocked-stage-label {
		font-size: 10px;
		font-weight: 500;
		color: #FF6B35;
	}

	.unlocked-actions {
		display: flex;
		flex-direction: row;
		gap: 8px;
	}

	.unlocked-action {
		flex: 1;
		height: 36px;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 4px;
		border-radius: 10px;
	}

	.unlocked-action-contact {
		background: #FFF3EC;
	}

	.unlocked-action-plan {
		background: #FF6B35;
	}

	.unlocked-action-icon {
		width: 14px;
		height: 14px;
	}

	.unlocked-action-text {
		font-size: 12px;
		font-weight: 500;
		color: #FF6B35;
	}

	.unlocked-action-text-plan {
		color: #FFFFFF;
	}

	.thinking-bubble {
		flex-direction: row;
		align-items: center;
		gap: 8px;
	}

	.thinking-text {
		font-size: 13px;
		line-height: 20px;
		color: #6B7280;
	}

	.thinking-dots {
		display: flex;
		flex-direction: row;
		align-items: flex-end;
		gap: 3px;
		height: 16px;
	}

	.thinking-dot {
		width: 4px;
		height: 4px;
		border-radius: 2px;
		background: #FF6B35;
		animation: thinking 1s infinite ease-in-out;
	}

	.dot-two {
		animation-delay: 0.15s;
	}

	.dot-three {
		animation-delay: 0.3s;
	}

	@keyframes thinking {
		0%, 80%, 100% {
			transform: translateY(0);
			opacity: 0.45;
		}
		40% {
			transform: translateY(-5px);
			opacity: 1;
		}
	}

	.chat-bottom-space {
		height: 4px;
	}

	.input-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 10px;
		height: 56px;
		padding: 0 12px 0 16px;
		box-sizing: border-box;
		background: #FFFFFF;
		box-shadow: 0 -2px 8px rgba(17, 18, 19, 0.05);
	}

	.types-search-fab {
		position: fixed;
		z-index: 10;
		display: flex;
		width: 52px;
		height: 52px;
		align-items: center;
		justify-content: center;
		overflow: visible;
	}

	.types-search-fab-snap {
		transition: left 0.2s ease, top 0.2s ease;
	}

	.types-search-fab-pressed {
		opacity: 0.92;
		transform: scale(0.96);
	}

	.types-search-fab-image {
		position: absolute;
		left: -14px;
		top: -14px;
		width: 80px;
		height: 86px;
	}

	.input-box {
		flex: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
		height: 40px;
		padding: 0 14px;
		box-sizing: border-box;
		background: #F7F8FA;
		border-radius: 999px;
	}

	.chat-input {
		flex: 1;
		height: 40px;
		padding: 0;
		font-size: 13px;
		font-weight: 400;
		color: #1A1D24;
		background: transparent;
		border: none;
		outline: none;
		box-shadow: none;
		-webkit-appearance: none;
		appearance: none;
	}

	.chat-input-placeholder {
		color: #9CA3AF;
	}

	.send-button {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		flex-shrink: 0;
		background: transparent;
		overflow: visible;
	}

	.send-button-disabled {
		opacity: 0.55;
	}

	.send-image {
		position: absolute;
		left: -10px;
		top: -10px;
		width: 56px;
		height: 60px;
	}

	.prescription-filter-page {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		z-index: 30;
		display: flex;
		flex-direction: column;
		background: #FFFFFF;
	}

	.prescription-filter-status {
		width: 100%;
		flex: 0 0 auto;
	}

	.prescription-filter-header {
		display: flex;
		height: 48px;
		flex: 0 0 48px;
		flex-direction: row;
		align-items: center;
		gap: 8px;
		padding: 0 16px;
		box-sizing: border-box;
		background: #FFFFFF;
	}

	.prescription-filter-back {
		display: flex;
		width: 28px;
		height: 28px;
		flex: 0 0 28px;
		align-items: center;
		justify-content: center;
	}

	.prescription-filter-back-text {
		margin-top: -2px;
		font-size: 28px;
		line-height: 30px;
		color: #1A1D24;
	}

	.prescription-filter-title {
		font-size: 17px;
		font-weight: 600;
		line-height: 24px;
		color: #1A1D24;
	}

	.prescription-filter-header-space {
		flex: 1;
	}

	.prescription-filter-reset {
		display: flex;
		height: 32px;
		align-items: center;
		justify-content: center;
		padding: 0 4px;
	}

	.prescription-filter-reset-text {
		font-size: 13px;
		line-height: 20px;
		color: #FF6B35;
	}

	.prescription-filter-scroll {
		min-height: 0;
		flex: 1;
		height: 0;
		background: #FFFFFF;
	}

	.prescription-filter-content {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 8px 16px 24px;
		box-sizing: border-box;
	}

	.prescription-filter-group {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.prescription-filter-group-head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.prescription-filter-group-title {
		font-size: 13px;
		font-weight: 600;
		line-height: 18px;
		color: #1A1D24;
	}

	.prescription-filter-chips {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 8px;
	}

	.prescription-filter-chip {
		display: flex;
		height: 33px;
		align-items: center;
		justify-content: center;
		padding: 0 14px;
		border: 1px solid #EDEFF2;
		border-radius: 999px;
		background: #FFFFFF;
		box-sizing: border-box;
	}

	.prescription-filter-chip-active {
		border-color: #FF6B35;
		background: #FFF0E8;
	}

	.prescription-filter-chip-text {
		font-size: 13px;
		font-weight: 400;
		line-height: 18px;
		color: #1A1D24;
	}

	.prescription-filter-chip-text-active {
		font-weight: 600;
		color: #FF6B35;
	}

	.prescription-filter-state {
		display: flex;
		min-height: 80px;
		align-items: center;
		justify-content: center;
	}

	.prescription-filter-state-text {
		font-size: 12px;
		line-height: 18px;
		color: #9CA3AF;
		text-align: center;
	}

	.prescription-filter-action-bar {
		display: flex;
		height: 56px;
		flex: 0 0 56px;
		flex-direction: row;
		align-items: center;
		gap: 10px;
		padding: 0 16px;
		box-sizing: border-box;
		background: #FFFFFF;
		box-shadow: 0 -2px 8px rgba(23, 26, 36, 0.05);
	}

	.prescription-filter-submit {
		display: flex;
		height: 40px;
		flex: 1;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background-image: linear-gradient(135deg, #FF8A3D 0%, #FF5224 100%);
		box-shadow: 0 6px 14px rgba(255, 82, 36, 0.35);
	}

	.prescription-filter-submit-disabled {
		opacity: 0.45;
	}

	.prescription-filter-submit-text {
		font-size: 14px;
		font-weight: 600;
		line-height: 20px;
		color: #FFFFFF;
	}

	.prescription-filter-search-button {
		position: relative;
		display: flex;
		width: 40px;
		height: 40px;
		flex: 0 0 40px;
		align-items: center;
		justify-content: center;
		overflow: visible;
	}

	.prescription-filter-search-button-disabled {
		opacity: 0.45;
	}

	.prescription-filter-search-image {
		position: absolute;
		left: -14px;
		top: -14px;
		width: 68px;
		height: 74px;
	}

	.prescription-results-page {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		z-index: 31;
		display: flex;
		flex-direction: column;
		background: #FFFFFF;
	}

	.prescription-results-selected {
		display: flex;
		flex: 0 0 auto;
		flex-direction: row;
		align-items: flex-start;
		gap: 8px;
		padding: 0 16px 10px;
		box-sizing: border-box;
	}

	.prescription-results-selected-label {
		flex: 0 0 auto;
		margin-top: 5px;
		font-size: 12px;
		line-height: 18px;
		color: #6B7280;
	}

	.prescription-results-selected-chips {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 8px;
	}

	.prescription-results-selected-chip {
		display: flex;
		height: 28px;
		align-items: center;
		justify-content: center;
		padding: 0 10px;
		border-radius: 999px;
		background: #FFF3EC;
		box-sizing: border-box;
	}

	.prescription-results-selected-chip-text {
		font-size: 11px;
		font-weight: 500;
		line-height: 16px;
		color: #FF6B35;
	}

	.prescription-results-scroll {
		min-height: 0;
		flex: 1;
		height: 0;
		background: #FFFFFF;
	}

	.prescription-results-content {
		padding: 0 16px 24px;
		box-sizing: border-box;
	}

	.prescription-results-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.prescription-result-card {
		position: relative;
		display: flex;
		min-height: 96px;
