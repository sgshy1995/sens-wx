		flex-direction: column;
		gap: 12px;
		padding: 12px 16px 40px;
		box-sizing: border-box;
	}

	.toolbar {
		display: flex;
		min-height: 32px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}

