		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		padding: 0 10px;
		border-radius: 999px;
	}

	.manage-button-active {
		background: #FFF0E8;
	}

	.manage-text {
		font-size: 12px;
		font-weight: 400;
		color: #9CA3AF;
		line-height: 18px;
	}

	.manage-text-active {
		font-weight: 500;
		color: #FF6B35;
	}

	.article-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.article-row {
		display: flex;
		width: 100%;
		flex-direction: row;
		align-items: center;
		gap: 2px;
	}

	.remove-button {
		display: flex;
		width: 32px;
		height: 32px;
		flex: 0 0 32px;
		align-items: center;
		justify-content: center;
	}

	.remove-circle {
		display: flex;
		width: 22px;
		height: 22px;
		align-items: center;
