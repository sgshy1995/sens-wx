<template>
	<view class="page">
		<view class="nav-space" :style="{ height: navSpaceHeight + 'px' }"></view>

		<view class="guide-header">
			<view class="back-button" @click="goBack">
				<text class="back-text">‹</text>
			</view>
			<text class="guide-title">登录前请阅读</text>
			<view class="header-space"></view>
		</view>

		<scroll-view class="guide-content" scroll-y>
			<view class="intro-card">
				<text class="intro-title">用户协议与隐私保护</text>
				<text class="intro-desc">使用手机号快捷登录前，请先阅读并同意以下内容。当前为占位文案，后续可直接替换协议正文。</text>
			</view>

			<view class="agreement-card">
				<text class="agreement-title">《用户服务协议》</text>
				<text class="agreement-placeholder">协议内容占位。后续补充账号使用规则、服务范围、用户权利与义务等内容。</text>
			</view>

			<view class="agreement-card">
				<text class="agreement-title">《隐私保护指引》</text>
				<text class="agreement-placeholder">隐私政策内容占位。后续补充手机号、微信标识、康复档案等信息的收集、使用和保护规则。</text>
			</view>
		</scroll-view>

		<view class="guide-footer">
			<view class="agreement-row" @click="toggleAgreement">
				<view class="checkbox" :class="{ 'checkbox-active': agreed }">
					<text v-if="agreed" class="checkbox-mark">✓</text>
				</view>
				<text class="agreement-text">我已阅读并同意《用户服务协议》和《隐私保护指引》</text>
			</view>

			<button
				v-if="agreed"
				class="submit-button"
				open-type="getPhoneNumber"
				:loading="submitting"
				@getphonenumber="onGetPhoneNumber"
			>
				<text class="submit-button-text">同意并手机号登录</text>
			</button>
			<button v-else class="submit-button submit-button-disabled" @click="showAgreementTip">
				<text class="submit-button-text submit-button-text-disabled">请先勾选同意</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { acceptLoginAgreement, loginByWechatPhone } from '../../common/auth'

	const navSpaceHeight = ref(64)
	const agreed = ref(false)
	const submitting = ref(false)

	onLoad(() => {
		const sys = uni.getSystemInfoSync()
		const status = sys.statusBarHeight
		navSpaceHeight.value = status + 44

		// #ifdef MP-WEIXIN
		const menuButton = wx.getMenuButtonBoundingClientRect()
		const menuGap = menuButton.top - status
		if (menuGap > 0) {
			navSpaceHeight.value = menuButton.bottom + menuGap
		}
		// #endif
	})

	function goBack (): void {
		if (submitting.value) {
			return
		}
		uni.navigateBack()
	}

	function toggleAgreement (): void {
		if (!submitting.value) {
			agreed.value = !agreed.value
		}
	}

	function showAgreementTip (): void {
		uni.showToast({
			title: '请先阅读并同意协议',
			icon: 'none'
		})
	}

	function onGetPhoneNumber (event: UniEvent): void {
		if (!agreed.value || submitting.value) {
			return
		}

		const phoneCode = event.detail.code as string
		if (phoneCode.length === 0) {
			uni.showToast({
				title: '未获取到手机号授权',
				icon: 'none'
			})
			return
		}

		submitting.value = true
		uni.showLoading({ title: '登录中' })
		loginByWechatPhone(phoneCode, () => {
			acceptLoginAgreement()
			submitting.value = false
			uni.hideLoading()
			uni.showToast({
				title: '登录成功',
				icon: 'success'
			})
			setTimeout(() => {
				uni.navigateBack()
			}, 500)
		}, (message) => {
			submitting.value = false
			uni.hideLoading()
			uni.showToast({
				title: message,
				icon: 'none'
			})
		})
	}
</script>

<style lang="scss">
	.page {
		flex: 1;
		min-height: 100vh;
		background: #F7F8FA;
	}

	.nav-space {
		background: #F7F8FA;
	}

	.guide-header {
		height: 52px;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 16px;
		padding-right: 16px;
		background: #F7F8FA;
	}

	.back-button {
		width: 32px;
		height: 32px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 16px;
		background: #FFFFFF;
	}

	.back-text {
		font-size: 28px;
		line-height: 30px;
		color: #1A1D24;
	}

	.guide-title {
		flex: 1;
		text-align: center;
		font-size: 17px;
		font-weight: 600;
		color: #1A1D24;
	}

	.header-space {
		width: 32px;
		height: 32px;
	}

	.guide-content {
		flex: 1;
		padding: 8px 16px 24px;
	}

	.intro-card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 20px;
		background: #FFFFFF;
		border-radius: 16px;
		box-shadow: 0 4px 16px rgba(23, 26, 36, 0.04);
	}

	.intro-title {
		font-size: 20px;
		font-weight: 700;
		color: #1A1D24;
	}

	.intro-desc {
		font-size: 13px;
		line-height: 21px;
		color: #6B7280;
	}

	.agreement-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-top: 16px;
		padding: 18px;
		background: #FFFFFF;
		border-radius: 16px;
	}

	.agreement-title {
		font-size: 15px;
		font-weight: 600;
		color: #1A1D24;
	}

	.agreement-placeholder {
		font-size: 13px;
		line-height: 22px;
		color: #9CA3AF;
	}

	.guide-footer {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 12px 16px 24px;
		background: #FFFFFF;
		box-shadow: 0 -4px 16px rgba(23, 26, 36, 0.06);
	}

	.agreement-row {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 8px;
	}

	.checkbox {
		width: 18px;
		height: 18px;
		margin-top: 1px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px solid #C2C7CF;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.checkbox-active {
		background: #FF6B35;
		border-color: #FF6B35;
	}

	.checkbox-mark {
		font-size: 12px;
		line-height: 12px;
		color: #FFFFFF;
	}

	.agreement-text {
		flex: 1;
		font-size: 12px;
		line-height: 19px;
		color: #6B7280;
	}

	.submit-button {
		width: 100%;
		height: 46px;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #FF6B35;
		border: none;
		border-radius: 23px;
		line-height: normal;
	}

	.submit-button::after {
		border: none;
	}

	.submit-button-disabled {
		background: #E5E7EB;
	}

	.submit-button-text {
		font-size: 15px;
		font-weight: 600;
		color: #FFFFFF;
	}

	.submit-button-text-disabled {
		color: #9CA3AF;
	}
</style>
