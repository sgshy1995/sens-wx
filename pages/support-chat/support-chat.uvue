<template>
	<view class="page">
		<view class="status-space" :style="{ height: statusBarHeight + 'px' }"></view>

		<view class="chat-header">
			<view class="back-button" @click="goBack">
				<text class="back-glyph">‹</text>
			</view>
			<view class="coach-avatar">
				<image class="coach-avatar-image" :src="adminAvatar" mode="aspectFill"></image>
			</view>
			<view class="coach-copy">
				<text class="coach-name">{{ adminName }}</text>
				<view class="coach-status-row">
					<view class="online-dot"></view>
					<text class="coach-status">在线</text>
				</view>
			</view>
			<view class="header-placeholder"></view>
		</view>

		<scroll-view
			class="message-scroll"
			scroll-y
			:scroll-top="scrollTop"
			:scroll-into-view="scrollIntoView"
			:upper-threshold="48"
			@scrolltoupper="loadOlderMessages"
		>
			<view class="message-list">
				<view v-if="initialLoading" class="list-status">
					<text class="list-status-text">正在加载消息...</text>
				</view>
				<view v-else-if="loadingOlder" class="list-status">
					<text class="list-status-text">正在加载更早消息...</text>
				</view>
				<view v-else-if="hasMore" class="list-status">
					<text class="list-status-text">下拉加载更早消息</text>
				</view>

				<view v-if="messages.length === 0 && !initialLoading" class="welcome-row">
					<view class="message-avatar-wrap">
						<image class="message-avatar" :src="adminAvatar" mode="aspectFill"></image>
					</view>
					<view class="welcome-bubble">
						<text class="welcome-text">
							您好，我是您的在线康复师。使用程序、日常训练或课程订单遇到问题时，都可以在这里告诉我。
						</text>
					</view>
				</view>

				<view
					v-for="(item, index) in messages"
					:key="item.id + '-' + index"
					class="message-block"
				>
					<text v-if="shouldShowTime(index)" class="time-separator">{{ item.timeText }}</text>
					<view class="message-row" :class="{ 'message-row-user': item.senderRole === 'user' }">
						<view v-if="item.senderRole !== 'user'" class="message-avatar-wrap">
							<image class="message-avatar" :src="adminAvatar" mode="aspectFill"></image>
						</view>
						<view
							class="message-bubble"
							:class="{
								'user-bubble': item.senderRole === 'user' && item.messageType !== 'course',
								'coach-bubble': item.senderRole !== 'user',
								'course-bubble': item.messageType === 'course'
							}"
						>
							<text
								v-if="item.messageType === 'text'"
								class="message-text"
								:class="{ 'user-message-text': item.senderRole === 'user' }"
							>{{ item.content }}</text>

							<image
								v-else-if="item.messageType === 'image'"
								class="image-message"
								:src="resolveFileUrl(item.mediaUrl)"
								mode="widthFix"
								@click="previewImage(item)"
							></image>

							<view v-else-if="item.messageType === 'video'" class="video-message-wrap">
								<video
									class="video-message"
									:src="resolveFileUrl(item.mediaUrl)"
									:poster="item.thumbnailUrl.length > 0 ? resolveFileUrl(item.thumbnailUrl) : ''"
									controls
									object-fit="contain"
								></video>
							</view>

							<view v-else-if="item.messageType === 'course' && item.course != null" class="course-message">
								<view class="course-kicker-row">
									<text class="course-kicker">组合课程订单</text>
									<text class="course-paid">已支付</text>
								</view>
								<text class="course-title">{{ courseTitle(item) }}</text>
								<text class="course-stage">{{ courseStage(item) }}</text>
								<view class="course-divider"></view>
								<view class="course-price-block">
									<text class="course-price">¥{{ coursePrice(item) }}</text>
									<text class="course-order-no">订单 {{ courseOrderNo(item) }}</text>
								</view>
								<view class="course-action" @click="openCourse(item)">
									<text class="course-action-text">查看完整方案</text>
								</view>
							</view>

							<text v-if="item.pending" class="message-state">发送中</text>
							<text v-if="item.failed" class="message-state message-failed">发送失败</text>
						</view>
					</view>
				</view>

				<view v-if="uploading" class="uploading-row">
					<view class="uploading-dot"></view>
					<text class="uploading-text">{{ uploadingLabel }}</text>
				</view>
				<view id="support-chat-bottom" class="chat-bottom-space"></view>
			</view>
		</scroll-view>

		<view class="composer">
			<view class="composer-main">
				<view class="plus-button" :class="{ 'plus-button-open': actionsVisible }" @click="toggleActions">
					<text class="plus-glyph">+</text>
				</view>
				<view class="input-shell">
					<input
						class="chat-input"
						:value="draft"
						:disabled="sending"
						placeholder="输入消息…"
						placeholder-class="chat-input-placeholder"
						confirm-type="send"
						maxlength="1000"
						@input="onDraftInput"
						@confirm="sendTextMessage"
					/>
				</view>
				<view
					class="send-button"
					:class="{ 'send-button-disabled': sending || draft.trim().length === 0 }"
					@click="sendTextMessage"
				>
					<image class="send-image" src="/static/icons/ic-send.svg" mode="aspectFit"></image>
				</view>
				<view class="order-button" @click="openOrderSheet">
					<image class="order-icon" src="/static/icons/ic-order.svg" mode="aspectFit"></image>
					<text class="order-button-text">订单</text>
				</view>
			</view>
		</view>

		<view v-if="actionsVisible" class="action-mask" @click="closeActions">
			<view class="action-panel" @click.stop>
				<view class="action-item" @click="chooseSupportImage(false)">
					<view class="action-icon-wrap">
						<image class="action-icon" src="/static/icons/ic-support-image.svg" mode="aspectFit"></image>
					</view>
					<text class="action-label">图片</text>
				</view>
				<view class="action-item" @click="chooseSupportVideo(false)">
					<view class="action-icon-wrap">
						<image class="action-icon" src="/static/icons/ic-support-video.svg" mode="aspectFit"></image>
					</view>
					<text class="action-label">视频</text>
				</view>
				<view class="action-item" @click="chooseSupportImage(true)">
					<view class="action-icon-wrap">
						<image class="action-icon" src="/static/icons/ic-support-camera.svg" mode="aspectFit"></image>
					</view>
					<text class="action-label">拍照</text>
				</view>
				<view class="action-hint">
					<text class="action-hint-text">图片 5MB 内 · 视频 30MB 内 · 发送前自动压缩</text>
				</view>
			</view>
		</view>

		<view v-if="orderSheetVisible" class="sheet-mask" @click="closeOrderSheet">
			<view class="order-sheet" @click.stop>
				<view class="sheet-header">
					<view class="sheet-title-wrap">
						<text class="sheet-title">选择要咨询的订单</text>
						<text class="sheet-subtitle">仅展示已解锁的组合课程</text>
					</view>
					<view class="sheet-close" @click="closeOrderSheet">
						<text class="sheet-close-text">×</text>
					</view>
				</view>
				<scroll-view class="order-list" scroll-y>
					<view v-if="loadingCourses" class="sheet-state">
						<text class="sheet-state-text">正在加载课程订单...</text>
					</view>
					<view v-else-if="orderCourses.length === 0" class="sheet-state">
						<text class="empty-order-title">暂无可咨询的课程订单</text>
						<text class="empty-order-subtitle">解锁组合课程后，可在这里发送订单卡片</text>
					</view>
					<template v-else>
						<view
							v-for="course in orderCourses"
							:key="course.courseId + '-' + course.stageId"
							class="order-option"
							:class="{ 'order-option-highlight': course.stageId === highlightStageId }"
							@click="sendCourseMessage(course)"
						>
							<view class="order-option-head">
								<text class="order-option-title">{{ course.courseTitle }}</text>
								<text class="order-option-price">¥{{ course.price }}</text>
							</view>
							<text class="order-option-stage">{{ course.stageTitle }}</text>
							<view class="order-option-foot">
								<text class="order-option-no">订单 {{ course.orderNo }}</text>
								<text class="order-option-time">{{ course.unlockedText }}</text>
							</view>
						</view>
					</template>
				</scroll-view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { hasLocalToken } from '../../common/auth'
	import {
		shouldShowSupportChatTime,
		SupportChatCourseOption,
		SupportChatMessage
	} from '../../common/support-chat'
	import { resolveFileUrl } from '../../common/forum'
	import { get, post } from '../../common/request'
	import { API_BASE_URL } from '../../common/config'
	import { buildUploadHeader } from '../../common/request'

	const MAX_IMAGE_SIZE: number = 5 * 1024 * 1024
	const MAX_VIDEO_SIZE: number = 30 * 1024 * 1024

	const statusBarHeight = ref(24)
	const adminName = ref('易赴康-康复师')
	const adminAvatar = ref('/static/icons/ic-help-avatar.png')
	const messages = ref<SupportChatMessage[]>([])
	const orderCourses = ref<SupportChatCourseOption[]>([])
	const draft = ref('')
	const initialLoading = ref(true)
	const loadingOlder = ref(false)
	const sending = ref(false)
	const uploading = ref(false)
	const uploadingLabel = ref('正在上传...')
	const loadingCourses = ref(false)
	const hasMore = ref(false)
	const nextBefore = ref('')
	const scrollIntoView = ref('')
	const scrollTop = ref(0)
	const actionsVisible = ref(false)
	const orderSheetVisible = ref(false)
	const highlightStageId = ref('')

	let pollTimer: number = -1
	let scrollTimer: number = -1
	let polling: boolean = false
	let destroyed: boolean = false
	let initialized: boolean = false
	let pageVisible: boolean = false
	let initialLoaded: boolean = false
	let initialRequesting: boolean = false

	onLoad((options) => {
		const sys = uni.getSystemInfoSync()
		statusBarHeight.value = sys.statusBarHeight
		if (options['stageId'] != null) {
			highlightStageId.value = options['stageId'] as string
		}
		initialized = true
		loadInitial()
	})

	onShow(() => {
		pageVisible = true
		if (!initialized || !hasLocalToken()) {
			return
		}
		if (!initialLoaded) {
			loadInitial()
		} else {
			startPolling()
		}
	})

	onHide(() => {
		pageVisible = false
		stopPolling()
	})

	onUnload(() => {
		destroyed = true
		pageVisible = false
		stopPolling()
		if (scrollTimer >= 0) {
			clearTimeout(scrollTimer)
			scrollTimer = -1
		}
	})

	function loadInitial (): void {
		if (initialRequesting) {
			return
		}
		if (!hasLocalToken()) {
			initialLoading.value = false
			uni.showModal({
				title: '请先登录',
				content: '登录后才能联系康复师',
				showCancel: false,
				success: () => {
					uni.navigateTo({ url: '/pages/login-guide/login-guide' })
				}
			})
			return
		}
		initialRequesting = true
		initialLoading.value = true
		get('/support_chat/overview', (overviewRes) => {
			loadLatestMessages()
		}, (message) => {
			initialRequesting = false
			initialLoading.value = false
			showError(message)
		})
	}

	function loadLatestMessages (): void {
		get('/support_chat/messages?pageSize=20', (res) => {
			initialRequesting = false
			initialLoading.value = false
			if (res.getNumber('code', 0) !== 200) {
				showError(res.getString('message') ?? '消息加载失败')
				return
			}
			const data = res.getJSON('data')
			if (data == null) {
				return
			}
			messages.value = parseMessages(data)
			initialLoaded = true
			hasMore.value = data.getBoolean('has_more') ?? false
			nextBefore.value = data.getString('next_before') ?? ''
			scheduleScrollToBottom()
			startPolling()
		}, (message) => {
			initialRequesting = false
			initialLoading.value = false
			showError(message)
		})
	}

	function parseMessages (data: UTSJSONObject): SupportChatMessage[] {
		const result: SupportChatMessage[] = []
		const list = data.getArray<UTSJSONObject>('messages')
		if (list == null) {
			return result
		}
		for (let i = 0; i < list.length; i++) {
			const item = new SupportChatMessage()
			item.initFromJSON(list[i])
			result.push(item)
		}
		return result
	}

	function loadOlderMessages (): void {
		if (loadingOlder.value || !hasMore.value || nextBefore.value.length === 0) {
			return
		}
		loadingOlder.value = true
		const url = '/support_chat/messages?before=' + encodeURIComponent(nextBefore.value) + '&pageSize=20'
		get(url, (res) => {
			loadingOlder.value = false
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const data = res.getJSON('data')
			if (data == null) {
				return
			}
			const older = parseMessages(data)
			hasMore.value = data.getBoolean('has_more') ?? false
			nextBefore.value = data.getString('next_before') ?? nextBefore.value
			if (older.length > 0) {
				const merged: SupportChatMessage[] = []
				for (let i = 0; i < older.length; i++) {
					merged.push(older[i])
				}
				for (let i = 0; i < messages.value.length; i++) {
					merged.push(messages.value[i])
				}
				messages.value = merged
				scrollTop.value = scrollTop.value + 480
			}
		}, () => {
			loadingOlder.value = false
		})
	}

	function startPolling (): void {
		if (destroyed || !pageVisible || pollTimer >= 0) {
			return
		}
		pollTimer = setTimeout(pollNewMessages, 3000)
	}

	function stopPolling (): void {
		if (pollTimer >= 0) {
			clearTimeout(pollTimer)
			pollTimer = -1
		}
	}

	function pollNewMessages (): void {
		pollTimer = -1
		if (destroyed || !pageVisible || !hasLocalToken()) {
			return
		}
		if (polling) {
			startPolling()
			return
		}
		const latest = latestMessageTime()
		if (latest.length === 0) {
			startPolling()
			return
		}
		polling = true
		const url = '/support_chat/messages?after=' + encodeURIComponent(latest) + '&pageSize=50'
		get(url, (res) => {
			polling = false
			if (res.getNumber('code', 0) === 200) {
				const data = res.getJSON('data')
				if (data != null) {
					const fresh = parseMessages(data)
					if (fresh.length > 0) {
						appendMessages(fresh)
						scheduleScrollToBottom()
					}
				}
			}
			startPolling()
		}, () => {
			polling = false
			startPolling()
		})
	}

	function latestMessageTime (): string {
		if (messages.value.length === 0) {
			return ''
		}
		return messages.value[messages.value.length - 1].createdAt
	}

	function appendMessages (fresh: SupportChatMessage[]): void {
		const merged: SupportChatMessage[] = []
		for (let i = 0; i < messages.value.length; i++) {
			merged.push(messages.value[i])
		}
		for (let i = 0; i < fresh.length; i++) {
			let exists = false
			for (let j = 0; j < merged.length; j++) {
				if (merged[j].id === fresh[i].id) {
					exists = true
					break
				}
			}
			if (!exists) {
				merged.push(fresh[i])
			}
		}
		messages.value = merged
	}

	function onDraftInput (event: UniEvent): void {
		draft.value = event.detail.value as string
	}

	function sendTextMessage (): void {
		if (sending.value) {
			return
		}
		const content = draft.value.trim()
		if (content.length === 0) {
			showError('请输入消息内容')
			return
		}
		const temp = createTempMessage('text', content)
		messages.value.push(temp)
		draft.value = ''
		sending.value = true
		closeActions()
		scheduleScrollToBottom()

		const body = new UTSJSONObject()
		body.set('message_type', 'text')
		body.set('content', content)
		post('/support_chat/messages', body, (res) => {
			sending.value = false
			handleSendResult(res, temp.id, '消息发送失败')
		}, (message) => {
			sending.value = false
			markMessageFailed(temp.id)
			showError(message)
		})
	}

	function chooseSupportImage (fromCamera: boolean): void {
		closeActions()
		wx.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: [fromCamera ? 'camera' : 'album'],
			success: (res) => {
				if (res.tempFilePaths.length === 0) {
					return
				}
				const sourcePath = res.tempFilePaths[0]
				wx.compressImage({
					src: sourcePath,
					quality: 70,
					success: (compressed) => {
						uploadSupportMedia(compressed.tempFilePath, 'image')
					},
					fail: () => {
						uploadSupportMedia(sourcePath, 'image')
					}
				})
			}
		})
	}

	function chooseSupportVideo (fromCamera: boolean): void {
		closeActions()
		wx.chooseVideo({
			sourceType: [fromCamera ? 'camera' : 'album'],
			compressed: true,
			maxDuration: 60,
			camera: 'back',
			success: (res) => {
				if (res.size > MAX_VIDEO_SIZE) {
					showError('视频本地压缩后仍需小于30MB，请选择更短的视频')
					return
				}
				uploadSupportMedia(res.tempFilePath, 'video')
			}
		})
	}

	function uploadSupportMedia (filePath: string, mediaType: string): void {
		if (uploading.value) {
			return
		}
		uploading.value = true
		uploadingLabel.value = mediaType === 'video' ? '正在压缩并上传视频...' : '正在压缩并上传图片...'
		uni.showLoading({ title: mediaType === 'video' ? '上传视频' : '上传图片', mask: true })
		wx.uploadFile({
			url: API_BASE_URL + '/support_chat/upload',
			filePath: filePath,
			name: 'file',
			header: buildUploadHeader(),
			formData: {
				media_type: mediaType
			},
			success: (response) => {
				let data: UTSJSONObject | null = null
				try {
					data = JSON.parse(response.data) as UTSJSONObject
				} catch (error) {
					data = null
				}
				if (data == null || data.getNumber('code', 0) !== 200) {
					finishUpload()
					showError(data == null ? '文件上传失败' : (data.getString('message') ?? '文件上传失败'))
					return
				}
				const payload = data.getJSON('data')
				if (payload == null) {
					finishUpload()
					showError('上传结果异常')
					return
				}
				const url = payload.getString('url') ?? ''
				const size = payload.getNumber('media_size', 0)
				if (url.length === 0) {
					finishUpload()
					showError('上传结果异常')
					return
				}
				sendMediaMessage(mediaType, url, size)
			},
			fail: () => {
				finishUpload()
				showError('文件上传失败，请稍后重试')
			}
		})
	}

	function sendMediaMessage (mediaType: string, url: string, size: number): void {
		const temp = createTempMessage(mediaType, '')
		temp.mediaUrl = url
		temp.mediaSize = size
		temp.pending = true
		messages.value.push(temp)
		scheduleScrollToBottom()
		const body = new UTSJSONObject()
		body.set('message_type', mediaType)
		body.set('media_url', url)
		body.set('media_size', size)
		post('/support_chat/messages', body, (res) => {
			finishUpload()
			handleSendResult(res, temp.id, mediaType === 'video' ? '视频发送失败' : '图片发送失败')
		}, (message) => {
			finishUpload()
			markMessageFailed(temp.id)
			showError(message)
		})
	}

	function finishUpload (): void {
		uploading.value = false
		uni.hideLoading()
	}

	function createTempMessage (messageType: string, content: string): SupportChatMessage {
		const message = new SupportChatMessage()
		message.id = 'temp-' + Date.now().toString()
		message.senderRole = 'user'
		message.messageType = messageType
		message.content = content
		message.createdAt = new Date().toISOString()
		message.timeText = '刚刚'
		message.pending = true
		return message
	}

	function handleSendResult (res: UTSJSONObject, tempId: string, fallback: string): void {
		if (res.getNumber('code', 0) !== 200) {
			markMessageFailed(tempId)
			showError(res.getString('message') ?? fallback)
			return
		}
		const data = res.getJSON('data')
		const messageJson = data == null ? null : data.getJSON('message')
		if (messageJson == null) {
			markMessageFailed(tempId)
			showError('发送结果异常')
			return
		}
		const finalMessage = new SupportChatMessage()
		finalMessage.initFromJSON(messageJson)
		for (let i = 0; i < messages.value.length; i++) {
			if (messages.value[i].id === tempId) {
				messages.value[i] = finalMessage
				break
			}
		}
		scheduleScrollToBottom()
	}

	function markMessageFailed (tempId: string): void {
		for (let i = 0; i < messages.value.length; i++) {
			if (messages.value[i].id === tempId) {
				messages.value[i].pending = false
				messages.value[i].failed = true
				break
			}
		}
	}

	function openOrderSheet (): void {
		closeActions()
		orderSheetVisible.value = true
		loadCourseOptions()
	}

	function closeOrderSheet (): void {
		orderSheetVisible.value = false
	}

	function loadCourseOptions (): void {
		if (loadingCourses.value) {
			return
		}
		loadingCourses.value = true
		get('/support_chat/courses', (res) => {
			loadingCourses.value = false
			if (res.getNumber('code', 0) !== 200) {
				showError(res.getString('message') ?? '课程订单加载失败')
				return
			}
			const data = res.getJSON('data')
			const list = data == null ? null : data.getArray<UTSJSONObject>('courses')
			const parsed: SupportChatCourseOption[] = []
			if (list != null) {
				for (let i = 0; i < list.length; i++) {
					const item = new SupportChatCourseOption()
					item.initFromJSON(list[i])
					parsed.push(item)
				}
			}
			orderCourses.value = parsed
		}, (message) => {
			loadingCourses.value = false
			showError(message)
		})
	}

	function sendCourseMessage (course: SupportChatCourseOption): void {
		if (sending.value) {
			return
		}
		const temp = createTempMessage('course', '')
		temp.course = course.toCard()
		messages.value.push(temp)
		orderSheetVisible.value = false
		sending.value = true
		scheduleScrollToBottom()
		const body = new UTSJSONObject()
		body.set('message_type', 'course')
		body.set('course_id', course.courseId)
		body.set('stage_id', course.stageId)
		post('/support_chat/messages', body, (res) => {
			sending.value = false
			handleSendResult(res, temp.id, '课程订单发送失败')
		}, (message) => {
			sending.value = false
			markMessageFailed(temp.id)
			showError(message)
		})
	}

	function courseTitle (message: SupportChatMessage): string {
		return message.course == null ? '' : message.course.courseTitle
	}

	function courseStage (message: SupportChatMessage): string {
		return message.course == null ? '' : message.course.stageTitle
	}

	function coursePrice (message: SupportChatMessage): string {
		return message.course == null ? '0' : message.course.price
	}

	function courseOrderNo (message: SupportChatMessage): string {
		return message.course == null ? '' : message.course.orderNo
	}

	function openCourse (message: SupportChatMessage): void {
		if (message.course == null || message.course.stageId.length === 0) {
			return
		}
		uni.navigateTo({
			url: '/pages/rehab-plan/rehab-plan?stageId=' + encodeURIComponent(message.course.stageId)
				+ '&courseTitle=' + encodeURIComponent(message.course.courseTitle)
		})
	}

	function previewImage (message: SupportChatMessage): void {
		const url = resolveFileUrl(message.mediaUrl)
		if (url.length === 0) {
			return
		}
		uni.previewImage({
			urls: [url],
			current: url
		})
	}

	function shouldShowTime (index: number): boolean {
		if (index === 0) {
			return true
		}
		return shouldShowSupportChatTime(
			messages.value[index].createdAt,
			messages.value[index - 1].createdAt
		)
	}

	function toggleActions (): void {
		actionsVisible.value = !actionsVisible.value
		if (actionsVisible.value) {
			orderSheetVisible.value = false
		}
	}

	function closeActions (): void {
		actionsVisible.value = false
	}

	function scheduleScrollToBottom (): void {
		scrollIntoView.value = ''
		if (scrollTimer >= 0) {
			clearTimeout(scrollTimer)
		}
		scrollTimer = setTimeout(() => {
			scrollIntoView.value = 'support-chat-bottom'
			scrollTimer = -1
		}, 30)
	}

	function showError (message: string): void {
		uni.showToast({
			title: message.length > 30 ? '操作失败，请稍后重试' : message,
			icon: 'none'
		})
	}

	function goBack (): void {
		uni.navigateBack()
	}
</script>

