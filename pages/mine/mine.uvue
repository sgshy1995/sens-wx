<template>
	<view class="page">
		<view class="nav-space" :style="{ height: navSpaceHeight + 'px' }"></view>

		<view class="mine-content">
			<view class="profile-card">
				<button
					class="tap-button user-row"
					hover-class="none"
					:open-type="canTriggerPhoneLogin() ? 'getPhoneNumber' : ''"
					@click="handleLoginTap"
					@getphonenumber="onGetPhoneNumber"
				>
					<image v-if="avatarUrl.length > 0" class="avatar" :src="avatarUrl" mode="aspectFit"></image>
					<image v-else class="avatar" src="/static/icons/ic-avatar.svg" mode="aspectFit"></image>
					<view class="user-copy">
						<text class="user-name">{{ userName }}</text>
						<view v-if="loggedIn" class="user-tags">
							<view class="user-tag user-tag-member"><text class="user-tag-member-text">康复会员</text></view>
							<view class="user-tag user-tag-streak"><text class="user-tag-streak-text">已坚持 {{ rehabDays }} 天</text></view>
						</view>
						<text v-else class="user-hint">{{ userHint }}</text>
					</view>
					<image class="chevron-icon" src="/static/icons/ic-chevron.svg" mode="aspectFit"></image>
				</button>

				<view class="divider"></view>

				<view class="stats-row">
					<view class="stat-item">
						<text class="stat-value">{{ loggedIn ? rehabDays : '—' }}</text>
						<text class="stat-label">康复天数</text>
					</view>
					<view class="stat-item">
						<text class="stat-value">{{ loggedIn ? schemeCount : '—' }}</text>
						<text class="stat-label">康复方案</text>
					</view>
					<view class="stat-item">
						<text class="stat-value">{{ loggedIn ? collectCount : '—' }}</text>
						<text class="stat-label">收藏</text>
					</view>
					<view class="stat-item">
						<text class="stat-value">{{ loggedIn ? likeCount : '—' }}</text>
						<text class="stat-label">点赞</text>
					</view>
				</view>
			</view>

			<view v-if="loggedIn" class="account-card">
				<view class="account-section balance-section">
					<view class="account-head">
						<image class="account-icon" src="/static/icons/ic-credit.svg" mode="aspectFit"></image>
						<text class="account-label">余额</text>
					</view>
					<text class="account-value">¥ {{ balanceText }}</text>
					<view class="recharge-button">
						<text class="recharge-button-text">充值</text>
					</view>
				</view>

				<view class="account-divider"></view>

				<view class="account-section credit-section">
					<view class="account-head">
						<image class="account-icon" src="/static/icons/ic-credit.svg" mode="aspectFit"></image>
						<text class="account-label">积分</text>
					</view>
					<text class="account-value">{{ integralText }}</text>
				</view>
			</view>

			<view v-else class="login-card">
				<view class="login-copy">
					<view class="login-title-row">
						<image class="phone-icon" src="/static/icons/ic-phone.svg" mode="aspectFit"></image>
						<text class="login-title">手机号一键登录</text>
					</view>
					<text class="login-subtitle">登录后同步钱包余额与康复档案</text>
				</view>
				<button
					class="tap-button login-button"
					hover-class="none"
					:open-type="canTriggerPhoneLogin() ? 'getPhoneNumber' : ''"
					@click="handleLoginTap"
					@getphonenumber="onGetPhoneNumber"
				>
					<text class="login-button-text">立即登录</text>
				</button>
			</view>

			<view class="menu-card">
				<button
					class="tap-button menu-row"
					hover-class="none"
					:open-type="canTriggerPhoneLogin() ? 'getPhoneNumber' : ''"
					@click="handleLoginTap"
					@getphonenumber="onGetPhoneNumber"
				>
					<image class="menu-icon" src="/static/icons/ic-personal-data.svg" mode="aspectFit"></image>
					<text class="menu-title">个人资料</text>
					<image class="chevron-icon" src="/static/icons/ic-chevron.svg" mode="aspectFit"></image>
				</button>
				<view class="menu-divider"></view>

				<button
					class="tap-button menu-row"
					hover-class="none"
					:open-type="canTriggerPhoneLogin() ? 'getPhoneNumber' : ''"
					@click="handleLoginTap"
					@getphonenumber="onGetPhoneNumber"
				>
					<image class="menu-icon" src="/static/icons/ic-pain-data.svg" mode="aspectFit"></image>
					<text class="menu-title">伤痛档案</text>
					<text v-if="loggedIn" class="menu-extra">{{ painRecordCount }} 条记录</text>
					<image class="chevron-icon" src="/static/icons/ic-chevron.svg" mode="aspectFit"></image>
				</button>
				<view class="menu-divider"></view>

				<button
					class="tap-button menu-row"
					hover-class="none"
					:open-type="canTriggerPhoneLogin() ? 'getPhoneNumber' : ''"
					@click="handleLoginTap"
					@getphonenumber="onGetPhoneNumber"
				>
					<image class="menu-icon" src="/static/icons/ic-mine-scheme.svg" mode="aspectFit"></image>
					<text class="menu-title">我的方案</text>
					<image class="chevron-icon" src="/static/icons/ic-chevron.svg" mode="aspectFit"></image>
				</button>
				<view class="menu-divider"></view>

				<button
					class="tap-button menu-row"
					hover-class="none"
					:open-type="canTriggerPhoneLogin() ? 'getPhoneNumber' : ''"
					@click="handleLoginTap"
					@getphonenumber="onGetPhoneNumber"
				>
					<image class="menu-icon" src="/static/icons/ic-mine-collect.svg" mode="aspectFit"></image>
					<text class="menu-title">我的收藏</text>
					<image class="chevron-icon" src="/static/icons/ic-chevron.svg" mode="aspectFit"></image>
				</button>
				<view class="menu-divider"></view>

				<button
					class="tap-button menu-row"
					hover-class="none"
					:open-type="canTriggerPhoneLogin() ? 'getPhoneNumber' : ''"
					@click="handleLoginTap"
					@getphonenumber="onGetPhoneNumber"
				>
					<image class="menu-icon" src="/static/icons/ic-contact.svg" mode="aspectFit"></image>
					<text class="menu-title">联系客服</text>
					<image class="chevron-icon" src="/static/icons/ic-chevron.svg" mode="aspectFit"></image>
				</button>
				<view class="menu-divider"></view>

				<button
					class="tap-button menu-row"
					hover-class="none"
					:open-type="canTriggerPhoneLogin() ? 'getPhoneNumber' : ''"
					@click="handleLoginTap"
					@getphonenumber="onGetPhoneNumber"
				>
					<image class="menu-icon" src="/static/icons/ic-settings.svg" mode="aspectFit"></image>
					<text class="menu-title">设置</text>
					<image class="chevron-icon" src="/static/icons/ic-chevron.svg" mode="aspectFit"></image>
				</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { calculateRehabDays, fetchCurrentUser, fetchCurrentUserInfo, hasLoginAgreement, hasLocalToken, loginByWechatPhone } from '../../common/auth'
	import { resolveFileUrl } from '../../common/forum'
	import { get } from '../../common/request'

	const navSpaceHeight = ref(64)
	const agreementAccepted = ref(false)
	const loggedIn = ref(false)
	const userName = ref('未登录')
	const userHint = ref('点击登录，同步康复计划与伤痛档案')
	const avatarUrl = ref('')
	const rehabDays = ref(1)
	const schemeCount = ref(0)
	const collectCount = ref(0)
	const likeCount = ref(0)
	const painRecordCount = ref(0)
	const integralText = ref('0')
	const balanceText = ref('0.00')

	onLoad(() => {
		const sys = uni.getSystemInfoSync()
		const status = sys.statusBarHeight
		navSpaceHeight.value = status + 44

		// #ifdef MP-WEIXIN
		const menuButton = wx.getMenuButtonBoundingClientRect()
		const menuGap = menuButton.top - status
		if (menuGap > 0) {
			navSpaceHeight.value = menuButton.bottom + menuGap
		}
		// #endif
	})

	onShow(() => {
		refreshLoginState()
	})

	function refreshLoginState (): void {
		agreementAccepted.value = hasLoginAgreement()
		if (!hasLocalToken()) {
			resetAuthenticatedState()
			return
		}

		loggedIn.value = true
		fetchCurrentUser((user) => {
			updateUserView(user)
			loadMineMetrics(user)
		}, () => {
			resetAuthenticatedState()
		})
	}

	function updateUserView (user: UTSJSONObject): void {
		const name = user.getString('name') ?? ''
		const phone = user.getString('phone') ?? ''
		const avatar = user.getString('avatar') ?? ''
		const createdAt = user.getString('created_at') ?? ''

		userName.value = name.length > 0 ? name : (phone.length > 0 ? phone : '微信用户')
		userHint.value = phone.length > 0 ? phone : '已登录'
		avatarUrl.value = avatar.length > 0 ? resolveFileUrl(avatar) : ''
		rehabDays.value = calculateRehabDays(createdAt)
	}

	function loadMineMetrics (user: UTSJSONObject): void {
		const userId = user.getString('id') ?? ''
		fetchCurrentUserInfo((userInfo) => {
			balanceText.value = userInfo.getString('balance') ?? '0.00'
			integralText.value = userInfo.getNumber('integral', 0).toString()
		}, () => {})

		get('/patient_course', (res) => {
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const list = res.getArray<UTSJSONObject>('data')
			schemeCount.value = list == null ? 0 : list.length
		}, () => {})

		get('/forum_like/count', (res) => {
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const data = res.getJSON('data')
			likeCount.value = data == null ? 0 : data.getNumber('count', 0)
		}, () => {})

		get('/forum_favorite/count', (res) => {
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const data = res.getJSON('data')
			collectCount.value = data == null ? 0 : data.getNumber('count', 0)
		}, () => {})

		if (userId.length === 0) {
			return
		}
		get('/pain_question/custom?pageNo=1&pageSize=1&user_id=' + userId, (res) => {
			if (res.getNumber('code', 0) !== 200) {
				return
			}
			const data = res.getJSON('data')
			painRecordCount.value = data == null ? 0 : data.getNumber('totalCount', 0)
		}, () => {})
	}

	function resetAuthenticatedState (): void {
		loggedIn.value = false
		userName.value = '未登录'
		userHint.value = '点击登录，同步康复计划与伤痛档案'
		avatarUrl.value = ''
		rehabDays.value = 1
		schemeCount.value = 0
		collectCount.value = 0
		likeCount.value = 0
		painRecordCount.value = 0
		integralText.value = '0'
		balanceText.value = '0.00'
	}

	function canTriggerPhoneLogin (): boolean {
		return agreementAccepted.value && !loggedIn.value
	}

	function handleLoginTap (): void {
		if (loggedIn.value) {
			return
		}
		if (!agreementAccepted.value) {
			uni.navigateTo({
				url: '/pages/login-guide/login-guide'
			})
		}
	}

	function onGetPhoneNumber (event: UniEvent): void {
		if (!canTriggerPhoneLogin()) {
			return
		}

		const phoneCode = event.detail.code as string
		if (phoneCode.length === 0) {
			uni.showToast({
				title: '未获取到手机号授权',
				icon: 'none'
			})
			return
		}

		uni.showLoading({ title: '登录中' })
		loginByWechatPhone(phoneCode, () => {
			uni.hideLoading()
			uni.showToast({
				title: '登录成功',
				icon: 'success'
			})
			refreshLoginState()
		}, (message) => {
			uni.hideLoading()
			uni.showToast({
				title: message,
				icon: 'none'
			})
		})
	}
</script>

