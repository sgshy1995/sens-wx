		width: 100%;
	}

	.nav-row {
		display: flex;
		height: 44px;
		flex-direction: row;
		align-items: center;
	}

	.back-button {
		display: flex;
		width: 32px;
		height: 32px;
		align-items: center;
		justify-content: center;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.18);
	}

	.back-glyph {
		margin-top: -3px;
		font-size: 28px;
		line-height: 28px;
		color: #FFFFFF;
	}

	.nav-title {
		flex: 1;
		text-align: center;
		font-size: 17px;
		font-weight: 600;
		color: #FFFFFF;
	}

	.nav-placeholder {
		width: 32px;
		height: 32px;
	}

	.summary-row {
		display: flex;
		flex-direction: row;
		gap: 8px;
		margin-top: 8px;
	}

	.summary-chip {
		padding: 6px 11px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.18);
	}

	.summary-chip-text {
		font-size: 11px;
		color: #FFFFFF;
	}

	.content-scroll {
		min-height: 0;
		flex: 1;
		height: 0;
	}

	.content {
		display: flex;
		flex-direction: column;
		padding: 16px 16px 44px;
		box-sizing: border-box;
	}

	.state-card,
	.empty-card {
		display: flex;
		min-height: 220px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 24px;
		box-sizing: border-box;
		border: 1px solid #EEF0F3;
		border-radius: 16px;
		background: #FFFFFF;
	}

	.state-text {
		font-size: 12px;
		color: #9CA3AF;
	}

	.empty-icon {
		width: 54px;
		height: 54px;
	}

	.empty-title {
		margin-top: 14px;
		font-size: 15px;
		font-weight: 600;
		color: #343A42;
	}

	.empty-description {
		margin-top: 6px;
		font-size: 11px;
		color: #9CA3AF;
	}

	.empty-action {
		display: flex;
		height: 34px;
		align-items: center;
		justify-content: center;
		margin-top: 18px;
		padding: 0 18px;
		border-radius: 17px;
		background: #FFF0E8;
	}

	.empty-action-text {
		font-size: 12px;
		color: #F05A2A;
	}

	.plan-list {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid #EEF0F3;
		border-radius: 16px;
		background: #FFFFFF;
		box-shadow: 0 4px 16px rgba(23, 26, 36, 0.04);
	}

	.plan-row {
		display: flex;
		min-height: 82px;
		flex-direction: row;
		align-items: center;
		gap: 12px;
		margin: 0;
		padding: 12px;
		border-bottom: 1px solid #F3F4F6;
		border-radius: 0;
		background: #FFFFFF;
		text-align: left;
		line-height: normal;
	}

	.plan-row:last-child {
		border-bottom: 0;
	}

	.plan-row::after {
		border: none;
	}

	.plan-copy {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		gap: 5px;
	}

	.plan-title {
		overflow: hidden;
		font-size: 15px;
		font-weight: 600;
		color: #1F242B;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.plan-meta {
		font-size: 10px;
		color: #9CA3AF;
	}

	.plan-course {
		overflow: hidden;
		font-size: 10px;
		color: #7D838C;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.chevron {
		width: 16px;
		height: 16px;
		flex: 0 0 16px;
	}

	.bottom-note {
		margin-top: 16px;
		text-align: center;
		font-size: 11px;
		color: #9CA3AF;
	}
</style>
