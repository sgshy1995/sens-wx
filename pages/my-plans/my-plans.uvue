<template>
	<view class="page">
		<view class="hero">
			<view class="status-space" :style="{ height: statusBarHeight + 'px' }"></view>
			<view class="nav-row">
				<view class="back-button" @click="goBack">
					<text class="back-glyph">‹</text>
				</view>
				<text class="nav-title">我的方案</text>
				<view class="nav-placeholder"></view>
			</view>
			<view class="summary-row">
				<view class="summary-chip">
					<text class="summary-chip-text">已购 {{ plans.length }} 个方案</text>
				</view>
				<view class="summary-chip">
					<text class="summary-chip-text">{{ activeCount }} 个有效</text>
				</view>
			</view>
		</view>

		<scroll-view class="content-scroll" scroll-y>
			<view class="content">
				<view v-if="loading" class="state-card">
					<text class="state-text">正在加载已购方案...</text>
				</view>
				<view v-else-if="loadFailed" class="state-card" @click="loadPlans">
					<text class="state-text">{{ failMessage }}，点击重试</text>
				</view>
				<view v-else-if="plans.length === 0" class="empty-card">
					<image class="empty-icon" src="/static/icons/ic-mine-scheme.svg" mode="aspectFit"></image>
					<text class="empty-title">还没有已购方案</text>
					<text class="empty-description">可以在康复页查看并解锁适合自己的组合课程</text>
					<view class="empty-action" @click="goRehab">
						<text class="empty-action-text">去康复页看看</text>
					</view>
				</view>
				<view v-else class="plan-list">
					<button
						v-for="plan in plans"
						:key="plan.id"
						class="plan-row"
						hover-class="none"
						@click="openPlan(plan)"
					>
						<view class="plan-copy">
							<text class="plan-title">{{ plan.displayTitle() }}</text>
							<text class="plan-meta">购买 {{ plan.purchaseDateText }} · {{ plan.validityText }}</text>
							<text v-if="plan.courseTitle.length > 0 && plan.courseTitle !== plan.displayTitle()" class="plan-course">{{ plan.courseTitle }}</text>
						</view>
						<image class="chevron" src="/static/icons/ic-chevron.svg" mode="aspectFit"></image>
					</button>
				</view>
				<text class="bottom-note">仅显示已购买的方案 · 新方案可在康复页购买</text>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { hasLocalToken } from '../../common/auth'
	import { PurchasedPlan } from '../../common/my-plans'
	import { get } from '../../common/request'

	const statusBarHeight = ref(24)
	const plans = ref<PurchasedPlan[]>([])
	const loading = ref(true)
	const loadFailed = ref(false)
	const failMessage = ref('方案加载失败')
	const loaded = ref(false)
	const requesting = ref(false)
	const activeCount = computed(() => {
		let count = 0
		for (let i = 0; i < plans.value.length; i++) {
			if (plans.value[i].status === 1) {
				count += 1
			}
		}
		return count
	})

	onLoad(() => {
		const sys = uni.getSystemInfoSync()
		statusBarHeight.value = sys.statusBarHeight
		if (!hasLocalToken()) {
			loading.value = false
			loadFailed.value = true
			failMessage.value = '请先登录后查看已购方案'
			return
		}
		loadPlans()
	})

	onShow(() => {
		if (loaded.value && hasLocalToken()) {
			loadPlans()
		}
	})

	function loadPlans (): void {
		if (requesting.value || !hasLocalToken()) {
			return
		}
		requesting.value = true
		loading.value = plans.value.length === 0
		loadFailed.value = false
		get('/rehab_combination_course/unlocks', (res) => {
			requesting.value = false
			loading.value = false
			if (res.getNumber('code', 0) !== 200) {
				loadFailed.value = true
				failMessage.value = res.getString('message') ?? '方案加载失败'
				return
			}
			const data = res.getJSON('data')
			const list = data == null ? null : data.getArray<UTSJSONObject>('data')
			const parsed: PurchasedPlan[] = []
			if (list != null) {
				for (let i = 0; i < list.length; i++) {
					const plan = new PurchasedPlan()
					plan.initFromJSON(list[i])
					parsed.push(plan)
				}
			}
			plans.value = parsed
			loaded.value = true
		}, (message) => {
			requesting.value = false
			loading.value = false
			loadFailed.value = true
			failMessage.value = message
		})
	}

	function openPlan (plan: PurchasedPlan): void {
		uni.navigateTo({
			url: '/pages/rehab-plan/rehab-plan?stageId=' + encodeURIComponent(plan.stageId)
				+ '&courseTitle=' + encodeURIComponent(plan.courseTitle)
		})
	}

	function goRehab (): void {
		uni.switchTab({ url: '/pages/rehab/rehab' })
	}

	function goBack (): void {
		uni.navigateBack()
	}
</script>

<style lang="scss">
	.page {
		display: flex;
		height: 100vh;
		flex-direction: column;
		overflow: hidden;
		background: #F7F8FA;
	}

	.hero {
		flex: 0 0 auto;
		padding: 0 20px 22px;
		background-image: linear-gradient(135deg, #FF8A3D 0%, #FF5224 100%);
	}

