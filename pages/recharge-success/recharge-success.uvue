<template>
	<view class="page">
		<view class="success-hero">
			<view class="safe-nav" :style="{ paddingTop: statusBarHeight + 'px' }">
				<view class="nav-row">
					<view class="back-button" @click="goBack">
						<text class="back-glyph">‹</text>
					</view>
					<view class="nav-placeholder"></view>
				</view>
			</view>

			<view class="success-ring">
				<image class="success-icon" src="/static/icons/ic-success.svg" mode="aspectFit"></image>
			</view>

			<text class="success-title">支付成功</text>
			<text class="success-subtitle">充值已实时到账，请注意查收</text>
		</view>

		<view class="result-content">
			<view class="result-card">
				<view class="result-row">
					<text class="result-label">充值金额</text>
					<text class="result-amount">¥{{ amountText }}</text>
				</view>
				<view class="result-divider"></view>
				<view class="result-row">
					<text class="result-label">支付方式</text>
					<text class="result-value">微信支付</text>
				</view>
				<view class="result-divider"></view>
				<view class="result-row">
					<text class="result-label">交易时间</text>
					<text class="result-value">{{ paymentTime }}</text>
				</view>
				<view class="result-divider"></view>
				<view class="result-row">
					<text class="result-label">订单编号</text>
					<text class="result-value">{{ orderNo.length > 0 ? orderNo : '生成中' }}</text>
				</view>
			</view>

			<text class="result-note">如遇支付问题，可联系在线客服</text>
		</view>

		<view class="footer">
			<button class="detail-button" hover-class="none" @click="viewBalanceDetail">
				<text class="detail-button-text">查看余额明细</text>
			</button>
			<button class="back-home-button" hover-class="none" @click="goBack">
				<text class="back-home-button-text">返回</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { formatMoney } from '../../common/money'

	const statusBarHeight = ref(24)
	const amountText = ref('0.00')
	const paymentTime = ref('')
	const orderNo = ref('')

	onLoad((options) => {
		const sys = uni.getSystemInfoSync()
		statusBarHeight.value = sys.statusBarHeight

		const amount = options['amount']
		if (amount != null) {
			amountText.value = formatMoney(amount as string, 2)
		}
		const time = options['time']
		if (time != null) {
			paymentTime.value = formatTransactionTime(time as string)
		} else {
			paymentTime.value = formatTransactionTime('')
		}
		const order = options['orderNo']
		if (order != null) {
			orderNo.value = order as string
		}
	})

	function formatTransactionTime (value: string): string {
		if (value.length === 0) {
			return currentTimeText()
		}
		if (value.length >= 16 && value.charAt(10) === 'T') {
			return value.substring(0, 10) + ' ' + value.substring(11, 16)
		}
		if (value.length >= 16 && value.charAt(10) === ' ') {
			return value.substring(0, 16)
		}
		const date = new Date(value)
		if (date.getTime() > 0) {
			return formatDateParts(date)
		}
		return value
	}

	function currentTimeText (): string {
		return formatDateParts(new Date())
	}

	function formatDateParts (date: Date): string {
		const month = padNumber(date.getMonth() + 1)
		const day = padNumber(date.getDate())
		const hour = padNumber(date.getHours())
		const minute = padNumber(date.getMinutes())
		return date.getFullYear().toString() + '-' + month + '-' + day + ' ' + hour + ':' + minute
	}

	function padNumber (value: number): string {
		return value < 10 ? '0' + value.toString() : value.toString()
	}

	function goBack (): void {
		uni.navigateBack()
	}

	function viewBalanceDetail (): void {
		uni.navigateTo({
			url: '/pages/balance-detail/balance-detail'
		})
	}
</script>

