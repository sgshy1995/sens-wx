		color: #9CA3AF;
	}

	.footer {
		display: flex;
		flex-direction: row;
		gap: 12px;
		padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
		background: #FFFFFF;
		box-shadow: 0 -4px 16px rgba(23, 26, 36, 0.06);
	}

	.back-button-footer,
	.view-button {
		height: 48px;
