		font-size: 12px;
		line-height: 18px;
		color: rgba(255, 255, 255, 0.8);
	}

	.result-content {
		flex: 1;
		padding: 32px 16px 24px;
	}

	.result-card {
		padding: 0 16px;
		background: #FFFFFF;
		border-radius: 14px;
		box-shadow: 0 4px 16px rgba(23, 26, 36, 0.04);
	}

	.result-row {
		min-height: 51px;
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 16px;
	}

	.result-label {
		width: 70px;
		font-size: 13px;
		color: #6B7280;
	}

	.result-value {
		flex: 1;
