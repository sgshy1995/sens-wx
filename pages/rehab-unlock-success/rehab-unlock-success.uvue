	}

	.view-button {
		flex: 1.35;
		background-image: linear-gradient(135deg, #FF8A3D 0%, #FF5124 100%);
	}

	.back-button-footer::after,
	.view-button::after {
		border: none;
	}

	.back-button-text {
		font-size: 14px;
		font-weight: 600;
		color: #6B7280;
	}

	.view-button-text {
		font-size: 14px;
		font-weight: 600;
		color: #FFFFFF;
	}
</style>
