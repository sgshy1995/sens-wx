<template>
	<view class="page">
		<view class="success-hero">
			<view class="safe-nav" :style="{ paddingTop: statusBarHeight + 'px' }">
				<view class="nav-row">
					<view class="back-button" @click="goBack">
						<text class="back-glyph">‹</text>
					</view>
					<view class="nav-placeholder"></view>
				</view>
			</view>

			<view class="success-ring">
				<image class="success-icon" src="/static/icons/ic-success.svg" mode="aspectFit"></image>
			</view>
			<text class="success-title">支付成功</text>
			<text class="success-amount">¥{{ amountText }}</text>
			<text class="success-subtitle">已解锁「{{ courseTitle }} · {{ stageTitle }}」</text>
		</view>

		<view class="result-content">
			<view class="result-card">
				<view class="result-row">
					<text class="result-label">商品名称</text>
					<text class="result-value">{{ courseTitle }}</text>
				</view>
				<view class="result-divider"></view>
				<view class="result-row">
					<text class="result-label">支付方式</text>
					<text class="result-value">{{ paymentTypeText }}</text>
				</view>
				<view class="result-divider"></view>
				<view class="result-row">
					<text class="result-label">交易时间</text>
					<text class="result-value">{{ paymentTime }}</text>
				</view>
				<view class="result-divider"></view>
				<view class="result-row">
					<text class="result-label">订单编号</text>
					<text class="result-value">{{ orderNo.length > 0 ? orderNo : '生成中' }}</text>
				</view>
			</view>
			<text class="result-note">方案已同步至康复页，如未解锁请联系客服</text>
		</view>

		<view class="footer">
			<button class="back-button-footer" hover-class="none" @click="goBack">
				<text class="back-button-text">返回康复页</text>
			</button>
			<button class="view-button" hover-class="none" @click="goRehabPage">
				<text class="view-button-text">查看康复方案</text>
			</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { formatMoney } from '../../common/money'

	const statusBarHeight = ref(24)
	const amountText = ref('0.00')
	const orderNo = ref('')
	const paymentTime = ref('')
	const paymentTypeText = ref('余额支付')
	const courseTitle = ref('康复方案')
	const stageTitle = ref('')
	const returnToFilter = ref(false)

	onLoad((options) => {
		const sys = uni.getSystemInfoSync()
		statusBarHeight.value = sys.statusBarHeight
		const amountOption = options['amount']
		if (amountOption != null) {
			amountText.value = formatMoney(decodeOption(amountOption as string), 2)
		}
		const orderNoOption = options['orderNo']
		if (orderNoOption != null) {
			orderNo.value = decodeOption(orderNoOption as string)
		}
		const timeOption = options['time']
		if (timeOption != null) {
			paymentTime.value = formatTransactionTime(decodeOption(timeOption as string))
		} else {
			paymentTime.value = formatTransactionTime('')
		}
		const paymentTypeOption = options['paymentTypeText']
		if (paymentTypeOption != null) {
			paymentTypeText.value = decodeOption(paymentTypeOption as string)
		}
		const courseTitleOption = options['courseTitle']
		if (courseTitleOption != null) {
			courseTitle.value = decodeOption(courseTitleOption as string)
		}
		const stageTitleOption = options['stageTitle']
		if (stageTitleOption != null) {
			stageTitle.value = decodeOption(stageTitleOption as string)
		}
		const returnToFilterOption = options['returnToFilter']
		if (returnToFilterOption != null) {
			returnToFilter.value = decodeOption(returnToFilterOption as string) === '1'
		}
	})

	function decodeOption (value: string): string {
		try {
			return decodeURIComponent(value)
		} catch (error) {
			return value
		}
	}

	function formatTransactionTime (value: string): string {
		if (value.length === 0) {
			return currentTimeText()
		}
		if (value.length >= 16 && value.charAt(10) === 'T') {
			return value.substring(0, 10) + ' ' + value.substring(11, 16)
		}
		if (value.length >= 16 && value.charAt(10) === ' ') {
			return value.substring(0, 16)
		}
		const date = new Date(value)
		if (date.getTime() > 0) {
			return formatDateParts(date)
		}
		return value
	}

	function currentTimeText (): string {
		return formatDateParts(new Date())
	}

	function formatDateParts (date: Date): string {
		return date.getFullYear().toString() + '-' + padNumber(date.getMonth() + 1) + '-' + padNumber(date.getDate())
			+ ' ' + padNumber(date.getHours()) + ':' + padNumber(date.getMinutes())
	}

	function padNumber (value: number): string {
		return value < 10 ? '0' + value.toString() : value.toString()
	}

	function goBack (): void {
		if (returnToFilter.value) {
			uni.navigateBack({
				delta: 1
			})
			return
		}
		uni.switchTab({
			url: '/pages/rehab/rehab'
		})
	}

	function goRehabPage (): void {
		if (returnToFilter.value) {
			uni.navigateBack({
				delta: 1
			})
			return
		}
		uni.switchTab({
			url: '/pages/rehab/rehab'
		})
	}
</script>

