<template>
	<view class="page">
		<view class="nav-shell" :style="{ paddingTop: statusBarHeight + 'px' }">
			<view class="nav-row">
				<view class="back-button" @click="goBack"><text class="back-glyph">‹</text></view>
				<text class="nav-title">确认方案</text>
				<view class="nav-placeholder"></view>
			</view>
		</view>

		<scroll-view class="content-scroll" scroll-y>
			<view class="content">
				<view v-if="loading" class="state-card">
					<image class="state-icon" src="/static/icons/ic-heart-beat.svg" mode="aspectFit"></image>
					<text class="state-title">正在生成方案</text>
					<text class="state-text">正在整理适合你的视频、图片和文字内容</text>
				</view>
				<view v-else-if="loadFailed" class="state-card" @click="loadPreview">
					<image class="state-icon" src="/static/icons/ic-empty.svg" mode="aspectFit"></image>
					<text class="state-title">暂时无法加载</text>
					<text class="state-text">{{ failMessage }}</text>
					<view class="retry-button"><text class="retry-text">重新生成</text></view>
				</view>
				<template v-else>
					<view class="hero-card">
						<text class="hero-title">专属康复方案</text>
						<text class="hero-subtitle">已根据您的伤痛情况描述，为您生成专属的康复训练方案</text>
						<view class="hero-bottom">
							<view class="hero-price-line">
								<view class="hero-price-row">
									<text class="hero-price-symbol">¥</text>
									<text class="price-current">{{ preview.price }}</text>
									<text v-if="preview.isDiscount && preview.originalPrice !== preview.price" class="price-original">¥{{ preview.originalPrice }}</text>
								</view>
								<view v-if="preview.isDiscount" class="discount-badge"><text class="discount-badge-text">专属优惠</text></view>
							</view>
							<image class="hero-illustration" src="/static/icons/ic-heart-beat.svg" mode="aspectFit"></image>
						</view>
					</view>

					<view class="details-panel">
						<view class="section">
							<view class="section-head">
								<view class="section-title-wrap">
									<view class="section-icon section-icon-tag">
										<image class="section-icon-image" src="/static/icons/ic-tag-pick.svg" mode="aspectFit"></image>
									</view>
									<text class="section-title">方案标签</text>
								</view>
								<text class="section-note">{{ selectedLabels.length }} 项</text>
							</view>
							<view class="chip-wrap">
								<view
									v-for="(label, index) in selectedLabels"
									:key="label.text + index"
									class="chip"
									:class="{ 'chip-primary': index === 0 }"
								>
									<view class="chip-dot"></view>
									<text class="chip-text">{{ label.text }}</text>
								</view>
							</view>
						</view>

						<view class="section-divider"></view>

						<view class="section">
							<view class="section-head">
								<view class="section-title-wrap">
									<view class="section-icon section-icon-plan">
										<image class="section-icon-image plan-icon-image" src="/static/icons/ic-mine-scheme.svg" mode="aspectFit"></image>
									</view>
									<text class="section-title">方案包含</text>
								</view>
								<text class="section-note">{{ preview.totalCount }} 项内容</text>
							</view>
							<view class="resource-grid">
								<view class="resource-item">
									<view class="resource-icon resource-icon-video">
										<image class="resource-icon-image" src="/static/icons/ic-support-video.svg" mode="aspectFit"></image>
									</view>
									<text class="resource-value">{{ preview.videoCount }}</text>
									<text class="resource-label">视频跟练</text>
								</view>
								<view class="resource-item">
									<view class="resource-icon resource-icon-photo">
										<image class="resource-icon-image" src="/static/icons/ic-support-image.svg" mode="aspectFit"></image>
									</view>
									<text class="resource-value">{{ preview.imageCount }}</text>
									<text class="resource-label">动作图片</text>
								</view>
								<view class="resource-item">
									<view class="resource-icon resource-icon-text">
										<image class="resource-icon-image" src="/static/icons/ic-comment.svg" mode="aspectFit"></image>
									</view>
									<text class="resource-value">{{ preview.textCount }}</text>
									<text class="resource-label">康复文字</text>
								</view>
							</view>
						</view>
					</view>

					<view class="assurance-row">
						<view class="assurance-icon">
							<image class="assurance-icon-image" src="/static/icons/ic-tips.svg" mode="aspectFit"></image>
						</view>
						<view class="assurance-copy">
							<text class="assurance-title">购买后立即解锁</text>
							<text class="assurance-text">完整内容将保存至“我的方案”，后续可随时查看</text>
						</view>
					</view>

				</template>
			</view>
		</scroll-view>

		<view class="footer-shell">
			<view v-if="!loading && !loadFailed" class="agreement-row" @click="agreementAccepted = !agreementAccepted">
				<view class="agreement-check" :class="{ 'agreement-check-active': agreementAccepted }">
					<text v-if="agreementAccepted" class="agreement-check-mark">✓</text>
				</view>
				<text class="agreement-text">我已阅读并同意</text>
				<text class="agreement-link">《康复方案服务协议》</text>
			</view>
			<view class="footer">
				<view class="total-group">
					<text class="total-label">应付金额</text>
					<view class="total-price-row">
						<text class="total-symbol">¥</text>
						<text class="total-amount">{{ preview.price }}</text>
					</view>
				</view>
				<view class="confirm-button" :class="{ 'confirm-button-disabled': confirmDisabled }" @click="confirmPurchase">
					<image v-if="!confirmDisabled" class="confirm-icon" src="/static/icons/ic-success.svg" mode="aspectFit"></image>
					<text class="confirm-button-text">确认购买</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { hasLocalToken } from '../../common/auth'
	import { PrescriptionFilterLabel, PrescriptionPlanPreview } from '../../common/prescription-filter'
	import { post } from '../../common/request'

	const statusBarHeight = ref(24)
	const prescriptionTagId = ref('')
	const dictionaryItemIds = ref('')
	const expectedSignature = ref('')
	const sourceType = ref('manual')
	const selectedLabels = ref<PrescriptionFilterLabel[]>([])
	const preview = ref<PrescriptionPlanPreview>(new PrescriptionPlanPreview())
	const loading = ref(true)
	const loadFailed = ref(false)
	const failMessage = ref('方案生成失败')
	const agreementAccepted = ref(false)

	const confirmDisabled = computed(() => {
		return loading.value || loadFailed.value || !agreementAccepted.value || !preview.value.payable || preview.value.totalCount < 1
	})

	onLoad((options) => {
		const sys = uni.getSystemInfoSync()
		statusBarHeight.value = sys.statusBarHeight
		prescriptionTagId.value = decodeOption(options['prescriptionTagId'] ?? '')
		dictionaryItemIds.value = decodeOption(options['dictionaryItemIds'] ?? '')
		expectedSignature.value = decodeOption(options['expectedSignature'] ?? '')
		sourceType.value = decodeOption(options['sourceType'] ?? 'manual')
		const labelsText = decodeOption(options['labels'] ?? '')
		if (labelsText.length > 0) {
			const labels = labelsText.split('|')
			const parsed: PrescriptionFilterLabel[] = []
			for (let i = 0; i < labels.length; i++) {
				const label = new PrescriptionFilterLabel()
				label.text = labels[i]
				parsed.push(label)
			}
			selectedLabels.value = parsed
		}
		loadPreview()
	})

	function decodeOption (value: string): string {
		try {
			return decodeURIComponent(value)
		} catch (error) {
			return value
		}
	}

	function loadPreview (): void {
		if (!hasLocalToken() || prescriptionTagId.value.length === 0) {
			loading.value = false
			loadFailed.value = true
			failMessage.value = '请先登录后生成康复方案'
			return
		}
		loading.value = true
		loadFailed.value = false
		const body = new UTSJSONObject()
		body.set('prescription_tag_id', prescriptionTagId.value)
		const itemIds = dictionaryItemIds.value.length > 0 ? dictionaryItemIds.value.split(',') : []
		const selectedItems: UTSJSONObject[] = []
		for (let i = 0; i < itemIds.length; i++) {
			const item = new UTSJSONObject()
			item.set('dictionary_item_id', itemIds[i])
			selectedItems.push(item)
		}
		body.set('dictionary_items', selectedItems)
		post('/rehab_plan/preview', body, (res) => {
			loading.value = false
			if (res.getNumber('code', 0) !== 200) {
				loadFailed.value = true
				failMessage.value = res.getString('message') ?? '方案生成失败'
				return
			}
			const data = res.getJSON('data')
			if (data == null) {
				loadFailed.value = true
				failMessage.value = '方案内容为空'
				return
			}
			const parsed = new PrescriptionPlanPreview()
			parsed.initFromJSON(data)
			preview.value = parsed
			if (parsed.totalCount < 1) {
				loadFailed.value = true
				failMessage.value = '当前条件暂未匹配到康复内容'
			}
		}, (message) => {
			loading.value = false
			loadFailed.value = true
			failMessage.value = message
		})
	}

	function confirmPurchase (): void {
		if (confirmDisabled.value) {
			if (!agreementAccepted.value && preview.value.totalCount > 0) {
				uni.showToast({ title: '请先勾选用户协议', icon: 'none' })
			}
			return
		}
		uni.navigateTo({
			url: '/pages/rehab-unlock/rehab-unlock?prescriptionTagId=' + encodeURIComponent(prescriptionTagId.value)
				+ '&dictionaryItemIds=' + encodeURIComponent(dictionaryItemIds.value)
				+ '&expectedSignature=' + encodeURIComponent(preview.value.planSignature)
				+ '&sourceType=' + encodeURIComponent(sourceType.value)
				+ '&agreementVersion=v1'
		})
	}

	function goBack (): void {
		uni.navigateBack()
	}
</script>

